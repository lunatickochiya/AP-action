#!/bin/sh /etc/rc.common

USE_PROCD=1
START=96
STOP=9

start_service() {
	local mode enabled
	mode="$(uci -q get mwan-switch.main.mode)"
	mode="${mode:-dual}"
	enabled="$(uci -q get mwan-switch.main.wan2_link_monitor)"
	enabled="${enabled:-0}"

	[ "$mode" = "dual" ] && [ "$enabled" = "1" ] || return 0

	procd_open_instance wan2-link
	procd_set_param command /usr/libexec/mwan-switch monitor
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 5
	procd_close_instance
}
