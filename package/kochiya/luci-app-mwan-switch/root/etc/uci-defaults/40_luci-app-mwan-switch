#!/bin/sh

rc_dir="${IPKG_INSTROOT:-}/etc/rc.d"
mkdir -p "$rc_dir"

# Do not call `/etc/init.d/mwan-switch enable` from firstboot.  Some rc.common
# versions block while loading a large procd action script.  Creating the two
# standard links directly is deterministic and does not start the service.
rm -f "$rc_dir/S95mwan-switch" "$rc_dir/K10mwan-switch"
ln -s ../init.d/mwan-switch "$rc_dir/S95mwan-switch"
ln -s ../init.d/mwan-switch "$rc_dir/K10mwan-switch"

# uci-defaults runs synchronously during first boot.  Never apply/reload the
# network here: doing so can block preinit while netifd and ubus are still
# starting.  Only prepare the monitor's boot-time enable state; LuCI save/apply
# will perform the actual configuration change later.
if [ -x /etc/init.d/mwan-switch-monitor ]; then
	monitor_enabled="$(uci -q get mwan-switch.main.wan2_link_monitor)"
	mode="$(uci -q get mwan-switch.main.mode)"
	rm -f "$rc_dir/S96mwan-switch-monitor" "$rc_dir/K09mwan-switch-monitor"
	if [ "${mode:-dual}" = "dual" ] && [ "${monitor_enabled:-0}" = "1" ]; then
		ln -s ../init.d/mwan-switch-monitor "$rc_dir/S96mwan-switch-monitor"
		ln -s ../init.d/mwan-switch-monitor "$rc_dir/K09mwan-switch-monitor"
	fi
fi

rm -f /tmp/luci-indexcache
rm -f /tmp/luci-modulecache/* 2>/dev/null

exit 0
