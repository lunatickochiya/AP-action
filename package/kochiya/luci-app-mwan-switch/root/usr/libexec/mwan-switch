#!/bin/sh

APP="mwan-switch"
LOCK_DIR="/var/lock/mwan-switch.lock"
RETURN_PATH_HELPER="/usr/libexec/mwan-switch-return-path"

NETWORK_CHANGED=0
DHCP_CHANGED=0
FIREWALL_CHANGED=0
WIRELESS_CHANGED=0
FOUND_SECTION=""
WIFI24_SECTION=""
WIFI5_SECTION=""
DETECTED_LAN_PORTS=""
DETECTED_LAN_COUNT=0
LAST_LAN_PORT=""
LAST_LAN_NUMBER=-1
TARGET_PREVIOUS_NETWORK="unknown"
TARGET_PORT_MOVED=0
WIFI24_PREVIOUS_NETWORK="unknown"
WIFI5_PREVIOUS_NETWORK="unknown"
WIFI24_NETWORK=""
WIFI5_NETWORK=""
WIFI24_MOVED=0
WIFI5_MOVED=0

log() {
	logger -t "$APP" "$*"
}

mark_changed() {
	case "$1" in
		network) NETWORK_CHANGED=1 ;;
		dhcp) DHCP_CHANGED=1 ;;
		firewall) FIREWALL_CHANGED=1 ;;
		wireless) WIRELESS_CHANGED=1 ;;
	esac
}

uci_set_type() {
	local package="$1" section="$2" type="$3" current
	current="$(uci -q get "$package.$section")"
	[ "$current" = "$type" ] && return 0

	[ -n "$current" ] && uci -q delete "$package.$section"
	uci set "$package.$section=$type"
	mark_changed "$package"
}

uci_set_value() {
	local package="$1" section="$2" option="$3" value="$4" current
	current="$(uci -q get "$package.$section.$option")"
	[ "$current" = "$value" ] && return 0

	uci set "$package.$section.$option=$value"
	mark_changed "$package"
}

uci_delete_option() {
	local package="$1" section="$2" option="$3"
	uci -q get "$package.$section.$option" >/dev/null || return 0

	uci -q delete "$package.$section.$option"
	mark_changed "$package"
}

uci_delete_section() {
	local package="$1" section="$2"
	uci -q get "$package.$section" >/dev/null || return 0

	uci -q delete "$package.$section"
	mark_changed "$package"
}

uci_set_list() {
	local package="$1" section="$2" option="$3" current desired item
	shift 3
	desired="$*"
	current="$(uci -q get "$package.$section.$option")"
	[ "$current" = "$desired" ] && return 0

	uci -q delete "$package.$section.$option"
	for item in "$@"; do
		[ -n "$item" ] && uci add_list "$package.$section.$option=$item"
	done
	mark_changed "$package"
}

uci_add_list_once() {
	local package="$1" section="$2" option="$3" value="$4" current
	current="$(uci -q get "$package.$section.$option")"
	case " $current " in
		*" $value "*) return 0 ;;
	esac

	uci add_list "$package.$section.$option=$value"
	mark_changed "$package"
}

uci_del_list_value() {
	local package="$1" section="$2" option="$3" value="$4" current
	current="$(uci -q get "$package.$section.$option")"
	case " $current " in
		*" $value "*) ;;
		*) return 0 ;;
	esac

	uci -q del_list "$package.$section.$option=$value"
	mark_changed "$package"
}

uci_replace_list_prefix() {
	local package="$1" section="$2" option="$3" prefix="$4" replacement="$5"
	local current new item
	current="$(uci -q get "$package.$section.$option")"
	new=""

	for item in $current; do
		case "$item" in
			"$prefix"*) ;;
			*) new="${new:+$new }$item" ;;
		esac
	done
	new="${new:+$new }$replacement"
	[ "$current" = "$new" ] && return 0

	uci -q delete "$package.$section.$option"
	for item in $new; do
		uci add_list "$package.$section.$option=$item"
	done
	mark_changed "$package"
}

list_sections() {
	local package="$1" type="$2"
	uci -q show "$package" | sed -n "s/^${package}\.\([^=]*\)=${type}$/\1/p"
}

list_all_sections() {
	local package="$1"
	uci -q show "$package" | sed -n "s/^${package}\.\([^.=]*\)=[^=]*$/\1/p"
}

move_section_to_position() {
	local package="$1" wanted="$2" target="$3" section current=-1 count=0
	for section in $(list_all_sections "$package"); do
		[ "$section" = "$wanted" ] && current="$count"
		count=$((count + 1))
	done
	[ "$current" -ge 0 ] || return 1
	[ "$current" -eq "$target" ] && return 0
	uci reorder "$package.$wanted=$target" || return 1
	mark_changed "$package"
}

access_rules_are_first() {
	local package="$1" section first_rule second_rule
	for section in $(list_all_sections "$package"); do
		[ "$(uci -q get "$package.$section")" = "rule" ] || continue
		if [ -z "$first_rule" ]; then
			first_rule="$section"
		elif [ -z "$second_rule" ]; then
			second_rule="$section"
			break
		fi
	done
	if [ "$LUNA_IPV6_FIREWALL" = "1" ]; then
		[ "$first_rule" = "mwan_luna_ipv6_access" ] && \
			[ "$second_rule" = "mwan_block_wan_to_lan_wan2" ]
	else
		[ "$first_rule" = "mwan_block_wan_to_lan_wan2" ]
	fi
}

find_section_one() {
	local package="$1" type="$2" option="$3" value="$4" section current
	FOUND_SECTION=""
	for section in $(list_sections "$package" "$type"); do
		current="$(uci -q get "$package.$section.$option")"
		if [ "$current" = "$value" ]; then
			FOUND_SECTION="$section"
			return 0
		fi
	done
	return 1
}

find_section_two() {
	local package="$1" type="$2" option1="$3" value1="$4" option2="$5" value2="$6"
	local section current1 current2
	FOUND_SECTION=""
	for section in $(list_sections "$package" "$type"); do
		current1="$(uci -q get "$package.$section.$option1")"
		current2="$(uci -q get "$package.$section.$option2")"
		if [ "$current1" = "$value1" ] && [ "$current2" = "$value2" ]; then
			FOUND_SECTION="$section"
			return 0
		fi
	done
	return 1
}

adopt_section_one() {
	local package="$1" type="$2" target="$3" option="$4" value="$5" current
	current="$(uci -q get "$package.$target")"
	[ "$current" = "$type" ] && return 0

	find_section_one "$package" "$type" "$option" "$value" || return 0
	[ "$FOUND_SECTION" = "$target" ] && return 0
	[ -n "$current" ] && uci -q delete "$package.$target"
	uci rename "$package.$FOUND_SECTION=$target"
	mark_changed "$package"
}

adopt_section_two() {
	local package="$1" type="$2" target="$3" option1="$4" value1="$5" option2="$6" value2="$7" current
	current="$(uci -q get "$package.$target")"
	[ "$current" = "$type" ] && return 0

	find_section_two "$package" "$type" "$option1" "$value1" "$option2" "$value2" || return 0
	[ "$FOUND_SECTION" = "$target" ] && return 0
	[ -n "$current" ] && uci -q delete "$package.$target"
	uci rename "$package.$FOUND_SECTION=$target"
	mark_changed "$package"
}

ensure_forwarding() {
	local section="$1" src="$2" dest="$3"
	uci_set_type firewall "$section" forwarding
	uci_set_value firewall "$section" src "$src"
	uci_set_value firewall "$section" dest "$dest"
	uci_delete_option firewall "$section" enabled
}

delete_forwardings() {
	local src="$1" dest="$2" section
	while find_section_two firewall forwarding src "$src" dest "$dest"; do
		section="$FOUND_SECTION"
		uci_delete_section firewall "$section"
	done
}

find_enabled_forwarding() {
	local src="$1" dest="$2" section
	FOUND_SECTION=""
	for section in $(list_sections firewall forwarding); do
		[ "$(uci -q get firewall.$section.enabled)" = "0" ] && continue
		[ "$(uci -q get firewall.$section.src)" = "$src" ] || continue
		[ "$(uci -q get firewall.$section.dest)" = "$dest" ] || continue
		FOUND_SECTION="$section"
		return 0
	done
	return 1
}

remove_network_from_other_zones() {
	local network_name="$1" keep_section="$2" section current filtered item
	for section in $(list_sections firewall zone); do
		[ "$section" = "$keep_section" ] && continue
		current="$(uci -q get firewall.$section.network)"
		filtered=""
		for item in $current; do
			[ "$item" = "$network_name" ] && continue
			filtered="${filtered:+$filtered }$item"
		done
		[ "$current" = "$filtered" ] && continue
		if [ -n "$filtered" ]; then
			uci_set_list firewall "$section" network $filtered
		else
			uci_delete_option firewall "$section" network
		fi
	done
}

detect_lan_ports() {
	local path name number
	DETECTED_LAN_PORTS=""
	DETECTED_LAN_COUNT=0
	LAST_LAN_PORT=""
	LAST_LAN_NUMBER=-1

	for path in /sys/class/net/lan[0-9]*; do
		[ -e "$path" ] || continue
		name="${path##*/}"
		number="${name#lan}"
		case "$number" in
			''|*[!0-9]*) continue ;;
		esac
		DETECTED_LAN_PORTS="${DETECTED_LAN_PORTS:+$DETECTED_LAN_PORTS }$name"
		DETECTED_LAN_COUNT=$((DETECTED_LAN_COUNT + 1))
		if [ "$number" -gt "$LAST_LAN_NUMBER" ]; then
			LAST_LAN_NUMBER="$number"
			LAST_LAN_PORT="$name"
		fi
	done
}

read_settings() {
	CONFIG_MODE="$(uci -q get mwan-switch.main.mode)"
	LAN4_UPLINK="$(uci -q get mwan-switch.main.target_lan_uplink)"
	[ -n "$LAN4_UPLINK" ] || LAN4_UPLINK="$(uci -q get mwan-switch.main.lan4_uplink)"
	LAN_ACCESS_TARGET="$(uci -q get mwan-switch.main.lan_access_target)"
	WIFI24_UPLINK="$(uci -q get mwan-switch.main.wifi24_uplink)"
	WIFI5_UPLINK="$(uci -q get mwan-switch.main.wifi5_uplink)"
	VPN_ISOLATION="$(uci -q get mwan-switch.main.vpn_isolation)"
	VPN_WAN1_ISOLATION="$(uci -q get mwan-switch.main.vpn_wan1_isolation)"
	VPN_WAN2_ISOLATION="$(uci -q get mwan-switch.main.vpn_wan2_isolation)"
	WAN2_LINK_MONITOR="$(uci -q get mwan-switch.main.wan2_link_monitor)"
	WAN2_LINK_RESTORE="$(uci -q get mwan-switch.main.wan2_link_restore)"
	WAN2_LINK_DELAY="$(uci -q get mwan-switch.main.wan2_link_delay)"
	WAN2_FAILOVER_ACTIVE="$(uci -q get mwan-switch.main.wan2_failover_active)"
	WAN2_LAN_IP="$(uci -q get mwan-switch.main.wan2_lan_ip)"
	WAN2_TABLE="$(uci -q get mwan-switch.main.wan2_table)"
	WAN2_PORT="$(uci -q get mwan-switch.main.wan2_port)"
	WAN2_PROTO="$(uci -q get mwan-switch.main.wan2_proto)"
	WAN2_PPPOE_USERNAME="$(uci -q get mwan-switch.main.wan2_pppoe_username)"
	WAN2_PPPOE_PASSWORD="$(uci -q get mwan-switch.main.wan2_pppoe_password)"
	WAN2_IPV6="$(uci -q get mwan-switch.main.wan2_ipv6)"
	LAN_DNS_MODE="$(uci -q get mwan-switch.main.lan_dns_mode)"
	WAN2_DNS_MODE="$(uci -q get mwan-switch.main.wan2_dns_mode)"
	LAN4_PORT_SETTING="$(uci -q get mwan-switch.main.target_lan_port)"
	if [ -z "$LAN4_PORT_SETTING" ]; then
		LAN4_PORT_SETTING="$(uci -q get mwan-switch.main.lan4_port)"
		case "$LAN4_PORT_SETTING" in
			''|lan4) LAN4_PORT_SETTING=auto ;;
		esac
	fi
	WIFI24_RADIO="$(uci -q get mwan-switch.main.wifi24_radio)"
	WIFI5_RADIO="$(uci -q get mwan-switch.main.wifi5_radio)"
	MANAGE_LUNA="$(uci -q get mwan-switch.main.manage_luna)"
	LUNA_MAC="$(uci -q get mwan-switch.main.luna_mac)"
	LUNA_IPV4_SUFFIX="$(uci -q get mwan-switch.main.luna_ipv4_suffix)"
	LUNA_IPV4_PORT_FORWARD="$(uci -q get mwan-switch.main.luna_ipv4_port_forward)"
	LUNA_IPV4_PORT="$(uci -q get mwan-switch.main.luna_ipv4_port)"
	LUNA_IPV6_FIREWALL="$(uci -q get mwan-switch.main.luna_ipv6_firewall)"
	LUNA_IPV6_DEST_SUFFIX="$(uci -q get mwan-switch.main.luna_ipv6_dest_suffix)"
	LAN_DNS4="$(uci -q get mwan-switch.main.lan_dns4)"
	LAN_DNS6="$(uci -q get mwan-switch.main.lan_dns6)"
	WAN2_DNS4="$(uci -q get mwan-switch.main.wan2_dns4)"
	WAN2_DNS6="$(uci -q get mwan-switch.main.wan2_dns6)"
	LUNA_ROUTES="$(uci -q get mwan-switch.main.luna_routes)"
	LUNA_IPV6_PORTS="$(uci -q get mwan-switch.main.luna_ipv6_ports)"

	CONFIG_MODE="${CONFIG_MODE:-dual}"
	LAN4_UPLINK="${LAN4_UPLINK:-wan2}"
	LAN_ACCESS_TARGET="${LAN_ACCESS_TARGET:-1}"
	WIFI24_UPLINK="${WIFI24_UPLINK:-wan2}"
	WIFI5_UPLINK="${WIFI5_UPLINK:-wan}"
	VPN_WAN1_ISOLATION="${VPN_WAN1_ISOLATION:-0}"
	VPN_WAN2_ISOLATION="${VPN_WAN2_ISOLATION:-1}"
	if [ -z "$VPN_ISOLATION" ]; then
		case "$VPN_WAN1_ISOLATION:$VPN_WAN2_ISOLATION" in
			0:0) VPN_ISOLATION=none ;;
			1:0) VPN_ISOLATION=wan1 ;;
			0:1) VPN_ISOLATION=wan2 ;;
			1:1) VPN_ISOLATION=both ;;
		esac
	fi
	case "$VPN_ISOLATION" in
		none) VPN_WAN1_ISOLATION=0; VPN_WAN2_ISOLATION=0 ;;
		wan1) VPN_WAN1_ISOLATION=1; VPN_WAN2_ISOLATION=0 ;;
		wan2) VPN_WAN1_ISOLATION=0; VPN_WAN2_ISOLATION=1 ;;
		both) VPN_WAN1_ISOLATION=1; VPN_WAN2_ISOLATION=1 ;;
	esac
	WAN2_LINK_MONITOR="${WAN2_LINK_MONITOR:-0}"
	WAN2_LINK_RESTORE="${WAN2_LINK_RESTORE:-1}"
	WAN2_LINK_DELAY="${WAN2_LINK_DELAY:-10}"
	WAN2_FAILOVER_ACTIVE="${WAN2_FAILOVER_ACTIVE:-0}"
	WAN2_LAN_IP="${WAN2_LAN_IP:-192.168.77.1}"
	WAN2_TABLE="${WAN2_TABLE:-200}"
	WAN2_PORT="${WAN2_PORT:-lan1}"
	WAN2_PROTO="${WAN2_PROTO:-dhcp}"
	WAN2_IPV6="${WAN2_IPV6:-1}"
	LAN_DNS_MODE="${LAN_DNS_MODE:-custom}"
	WAN2_DNS_MODE="${WAN2_DNS_MODE:-keep}"
	LAN4_PORT_SETTING="${LAN4_PORT_SETTING:-auto}"
	detect_lan_ports
	if [ "$LAN4_PORT_SETTING" = "auto" ]; then
		LAN4_PORT="$LAST_LAN_PORT"
	else
		LAN4_PORT="$LAN4_PORT_SETTING"
	fi
	WIFI24_RADIO="${WIFI24_RADIO:-radio0}"
	WIFI5_RADIO="${WIFI5_RADIO:-radio1}"
	MANAGE_LUNA="${MANAGE_LUNA:-1}"
	LUNA_MAC="${LUNA_MAC:-02:12:34:56:78:9A}"
	LUNA_IPV4_SUFFIX="${LUNA_IPV4_SUFFIX:-186}"
	LUNA_IPV4_PORT_FORWARD="${LUNA_IPV4_PORT_FORWARD:-1}"
	LUNA_IPV4_PORT="${LUNA_IPV4_PORT:-50000}"
	LUNA_IPV6_FIREWALL="${LUNA_IPV6_FIREWALL:-1}"
	LUNA_IPV6_DEST_SUFFIX="${LUNA_IPV6_DEST_SUFFIX:-789a}"
	LAN_DNS4="${LAN_DNS4:-1.1.1.1 8.8.8.8 223.5.5.5 9.9.9.9}"
	LAN_DNS6="${LAN_DNS6:-2606:4700:4700::1111 2001:4860:4860::8888 2400:3200::1 2620:fe::fe}"
	WAN2_DNS4="${WAN2_DNS4:-1.1.1.1 8.8.8.8 223.5.5.5 9.9.9.9}"
	WAN2_DNS6="${WAN2_DNS6:-2606:4700:4700::1111 2001:4860:4860::8888 2400:3200::1 2620:fe::fe}"
	LUNA_ROUTES="${LUNA_ROUTES:-172.16.7.0/24 192.168.8.0/24}"
	LUNA_IPV6_PORTS="${LUNA_IPV6_PORTS:-50000 50001}"
	LAN_IP="$(uci -q get network.lan.ipaddr)"
	LAN_IP="${LAN_IP:-192.168.7.1}"
	LAN_PREFIX="${LAN_IP%.*}"
	WAN2_PREFIX="${WAN2_LAN_IP%.*}"

	MODE="$CONFIG_MODE"
	if [ "$CONFIG_MODE" = "dual" ] && [ "$WAN2_LINK_MONITOR" = "1" ] && [ "$WAN2_FAILOVER_ACTIVE" = "1" ]; then
		MODE="wan_only"
	fi
	if [ "$MODE" = "dual" ] && [ "$LAN4_UPLINK" = "wan2" ]; then
		LUNA_NETWORK="lan_wan2"
		LUNA_IPV4="$WAN2_PREFIX.$LUNA_IPV4_SUFFIX"
		LUNA_SOURCE_ZONE="wan2"
		LUNA_DEST_ZONE="lan_wan2"
	else
		LUNA_NETWORK="lan"
		LUNA_IPV4="$LAN_PREFIX.$LUNA_IPV4_SUFFIX"
		LUNA_SOURCE_ZONE="wan"
		LUNA_DEST_ZONE="lan"
	fi
}

valid_mac() {
	case "$1" in
		[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]) return 0 ;;
		*) return 1 ;;
	esac
}

build_luna_ipv6_dest_ip() {
	local mac suffix old_ifs first_byte
	mac="$(printf '%s' "$LUNA_MAC" | tr 'A-F' 'a-f')"
	suffix="$(printf '%s' "$LUNA_IPV6_DEST_SUFFIX" | tr 'A-F' 'a-f')"
	old_ifs="$IFS"
	IFS=':'
	set -- $mac
	IFS="$old_ifs"
	[ "$#" -eq 6 ] || return 1
	first_byte="$(printf '%02x' $((0x$1 ^ 0x02)))" || return 1
	# Match the stable EUI-64 interface ID derived from luna_mac. The configurable
	# suffix replaces the last 16 bits, preserving the existing LuCI setting.
	LUNA_IPV6_DEST_IP="::${first_byte}${2}:${3}ff:fe${4}:${suffix}/::ffff:ffff:ffff:ffff"
}

valid_ipv4() {
	local old_ifs octet
	old_ifs="$IFS"
	IFS='.'
	set -- $1
	IFS="$old_ifs"
	[ "$#" -eq 4 ] || return 1

	for octet in "$@"; do
		case "$octet" in
			''|*[!0-9]*) return 1 ;;
		esac
		[ "$octet" -ge 0 ] && [ "$octet" -le 255 ] || return 1
	done
	return 0
}

valid_cidr4() {
	local value="$1" address prefix
	case "$value" in
		*/*) ;;
		*) return 1 ;;
	esac
	address="${value%/*}"
	prefix="${value#*/}"
	valid_ipv4 "$address" || return 1
	case "$prefix" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ "$prefix" -ge 0 ] && [ "$prefix" -le 32 ]
}

valid_port() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

validate_settings() {
	local br_lan pppoe_plugin plugin target port
	case "$CONFIG_MODE" in
		dual|wan_only) ;;
		*) log "无效 mode=$CONFIG_MODE"; return 1 ;;
	esac
	case "$LAN4_UPLINK" in
		wan|wan2) ;;
		*) log "无效 target_lan_uplink=$LAN4_UPLINK"; return 1 ;;
	esac
	case "$LAN_ACCESS_TARGET" in
		0|1) ;;
		*) log "无效 lan_access_target=$LAN_ACCESS_TARGET"; return 1 ;;
	esac
	case "$WIFI24_UPLINK" in
		wan|wan2) ;;
		*) log "无效 wifi24_uplink=$WIFI24_UPLINK"; return 1 ;;
	esac
	case "$WIFI5_UPLINK" in
		wan|wan2) ;;
		*) log "无效 wifi5_uplink=$WIFI5_UPLINK"; return 1 ;;
	esac
	case "$VPN_ISOLATION" in
		none|wan1|wan2|both) ;;
		*) log "无效 vpn_isolation=$VPN_ISOLATION"; return 1 ;;
	esac
	case "$WAN2_LINK_MONITOR" in
		0|1) ;;
		*) log "无效 wan2_link_monitor=$WAN2_LINK_MONITOR"; return 1 ;;
	esac
	case "$WAN2_LINK_RESTORE" in
		0|1) ;;
		*) log "无效 wan2_link_restore=$WAN2_LINK_RESTORE"; return 1 ;;
	esac
	case "$WAN2_FAILOVER_ACTIVE" in
		0|1) ;;
		*) log "无效 wan2_failover_active=$WAN2_FAILOVER_ACTIVE"; return 1 ;;
	esac
	case "$WAN2_PROTO" in
		dhcp|pppoe) ;;
		*) log "无效 wan2_proto=$WAN2_PROTO"; return 1 ;;
	esac
	case "$WAN2_DNS_MODE" in
		keep|custom) ;;
		*) log "无效 wan2_dns_mode=$WAN2_DNS_MODE"; return 1 ;;
	esac
	case "$LAN_DNS_MODE" in
		keep|custom) ;;
		*) log "无效 lan_dns_mode=$LAN_DNS_MODE"; return 1 ;;
	esac
	case "$WAN2_IPV6" in
		0|1) ;;
		*) log "无效 wan2_ipv6=$WAN2_IPV6"; return 1 ;;
	esac
	case "$MANAGE_LUNA" in
		0|1) ;;
		*) log "无效 manage_luna=$MANAGE_LUNA"; return 1 ;;
	esac
	case "$LUNA_IPV4_PORT_FORWARD" in
		0|1) ;;
		*) log "无效 luna_ipv4_port_forward=$LUNA_IPV4_PORT_FORWARD"; return 1 ;;
	esac
	if [ "$MANAGE_LUNA" = "1" ]; then
		case "$LUNA_IPV4_SUFFIX" in
			''|*[!0-9]*) log "无效 luna_ipv4_suffix=$LUNA_IPV4_SUFFIX"; return 1 ;;
		esac
		[ "$LUNA_IPV4_SUFFIX" -ge 2 ] && [ "$LUNA_IPV4_SUFFIX" -le 254 ] || {
			log "luna_ipv4_suffix 必须在 2 到 254 之间"
			return 1
		}
		[ -n "$LUNA_MAC" ] || {
			log "固定设备 MAC 不能为空"
			return 1
		}
		for target in $LUNA_ROUTES; do
			valid_cidr4 "$target" || {
				log "无效固定设备后方 IPv4 路由=$target"
				return 1
			}
		done
		if [ "$LUNA_IPV4_PORT_FORWARD" = "1" ]; then
			valid_port "$LUNA_IPV4_PORT" || {
				log "无效 luna_ipv4_port=$LUNA_IPV4_PORT"
				return 1
			}
		fi
	fi
	case "$LUNA_IPV6_FIREWALL" in
		0|1) ;;
		*) log "无效 luna_ipv6_firewall=$LUNA_IPV6_FIREWALL"; return 1 ;;
	esac
	if [ "$LUNA_IPV6_FIREWALL" = "1" ]; then
		valid_mac "$LUNA_MAC" || {
			log "无效 luna_mac=$LUNA_MAC"
			return 1
		}
		case "$LUNA_IPV6_DEST_SUFFIX" in
			''|*[!0-9A-Fa-f]*) log "无效 luna_ipv6_dest_suffix=$LUNA_IPV6_DEST_SUFFIX"; return 1 ;;
		esac
		[ "${#LUNA_IPV6_DEST_SUFFIX}" -le 4 ] || {
			log "luna_ipv6_dest_suffix 必须是 1 到 4 位十六进制字符"
			return 1
		}
		[ -n "$LUNA_IPV6_PORTS" ] || {
			log "luna_ipv6_ports 不能为空"
			return 1
		}
		for port in $LUNA_IPV6_PORTS; do
			valid_port "$port" || {
				log "无效固定设备 IPv6 放行端口=$port"
				return 1
			}
		done
		build_luna_ipv6_dest_ip || {
			log "无法根据 luna_mac 生成 IPv6 接口标识"
			return 1
		}
	fi
	case "$WAN2_LINK_DELAY" in
		''|*[!0-9]*) log "无效 wan2_link_delay=$WAN2_LINK_DELAY"; return 1 ;;
	esac
	[ "$WAN2_LINK_DELAY" -ge 4 ] && [ "$WAN2_LINK_DELAY" -le 300 ] || {
		log "wan2_link_delay 必须在 4 到 300 秒之间"
		return 1
	}
	[ -n "$WAN2_PORT" ] && [ -n "$LAN4_PORT" ] || {
		log "未检测到 WAN2 或目标 LAN 物理端口（检测到 $DETECTED_LAN_COUNT 个 lanN 网口）"
		return 1
	}
	if [ "$CONFIG_MODE" = "dual" ] && [ "$WAN2_PORT" = "$LAN4_PORT" ]; then
		log "WAN2 与最后一个 LAN 物理端口不能重复：$WAN2_PORT"
		return 1
	fi
	find_section_one network device name br-lan || {
		log "当前 network 中找不到 br-lan 设备"
		return 1
	}
	br_lan="$FOUND_SECTION"
	[ -n "$br_lan" ] && [ "$(uci -q get network.lan)" = "interface" ] && [ "$(uci -q get network.wan)" = "interface" ] || {
		log "当前 lan/wan 基础接口不完整"
		return 1
	}
	[ -e "/sys/class/net/$WAN2_PORT" ] && [ -e "/sys/class/net/$LAN4_PORT" ] || {
		log "找不到物理端口 $WAN2_PORT 或 $LAN4_PORT（检测到：${DETECTED_LAN_PORTS:-无}）"
		return 1
	}

	if [ "$CONFIG_MODE" = "dual" ]; then
		case "$WAN2_TABLE" in
			''|*[!0-9]*) log "无效 wan2_table=$WAN2_TABLE"; return 1 ;;
		esac
		[ "$WAN2_TABLE" -ge 1 ] && [ "$WAN2_TABLE" -le 252 ] || {
			log "wan2_table 必须在 1 到 252 之间"
			return 1
		}
		valid_ipv4 "$WAN2_LAN_IP" || {
			log "无效 wan2_lan_ip=$WAN2_LAN_IP"
			return 1
		}
		[ "$WAN2_PREFIX" != "$LAN_PREFIX" ] || {
			log "WAN2 内网不能与现有 LAN 使用同一个 /24 网段"
			return 1
		}
		if [ "$WAN2_PROTO" = "pppoe" ]; then
			[ -n "$WAN2_PPPOE_USERNAME" ] && [ -n "$WAN2_PPPOE_PASSWORD" ] || {
				log "WAN2 使用 PPPoE 时账号和密码不能为空"
				return 1
			}
			[ "${#WAN2_PPPOE_USERNAME}" -le 256 ] && [ "${#WAN2_PPPOE_PASSWORD}" -le 256 ] || {
				log "PPPoE 账号参数过长"
				return 1
			}
			[ -x /usr/sbin/pppd ] || {
				log "缺少 PPPoE 运行组件，请安装 ppp-mod-pppoe"
				return 1
			}
			pppoe_plugin=""
			for plugin in /usr/lib/pppd/*/pppoe.so; do
				[ -f "$plugin" ] && pppoe_plugin="$plugin" && break
			done
			[ -n "$pppoe_plugin" ] || {
				log "缺少 pppoe.so，请安装 ppp-mod-pppoe"
				return 1
			}
		fi
	fi

	return 0
}

normalize_failover_state() {
	[ "$WAN2_FAILOVER_ACTIVE" = "1" ] || return 0
	[ "$CONFIG_MODE" != "dual" ] || [ "$WAN2_LINK_MONITOR" != "1" ] || return 0

	uci set mwan-switch.main.wan2_failover_active='0'
	uci commit mwan-switch
	WAN2_FAILOVER_ACTIVE=0
	MODE="$CONFIG_MODE"
	log "已清除不再适用的 WAN2 自动故障状态"
}

normalize_vpn_isolation_setting() {
	local changed=0
	if [ "$(uci -q get mwan-switch.main.vpn_isolation)" != "$VPN_ISOLATION" ]; then
		uci set "mwan-switch.main.vpn_isolation=$VPN_ISOLATION" || return 1
		changed=1
	fi
	if uci -q get mwan-switch.main.vpn_wan1_isolation >/dev/null; then
		uci -q delete mwan-switch.main.vpn_wan1_isolation
		changed=1
	fi
	if uci -q get mwan-switch.main.vpn_wan2_isolation >/dev/null; then
		uci -q delete mwan-switch.main.vpn_wan2_isolation
		changed=1
	fi
	[ "$changed" = "1" ] || return 0
	uci commit mwan-switch || return 1
	log "已将旧版 VPN 双开关迁移为 vpn_isolation=$VPN_ISOLATION"
}

normalize_fixed_device_ipv4_settings() {
	local changed=0
	if uci -q get mwan-switch.main.luna_duid >/dev/null; then
		uci -q delete mwan-switch.main.luna_duid
		changed=1
	fi
	if uci -q get mwan-switch.main.luna_ipv6_suffix >/dev/null; then
		uci -q delete mwan-switch.main.luna_ipv6_suffix
		changed=1
	fi
	if uci -q get mwan-switch.main.wan1_access_lan4 >/dev/null; then
		uci -q delete mwan-switch.main.wan1_access_lan4
		changed=1
	fi
	[ "$changed" = "0" ] || uci commit mwan-switch
}

find_wifi_sections() {
	find_section_one wireless wifi-iface device "$WIFI24_RADIO" || {
		log "找不到 2.4G 无线接口 device=$WIFI24_RADIO"
		return 1
	}
	WIFI24_SECTION="$FOUND_SECTION"

	find_section_one wireless wifi-iface device "$WIFI5_RADIO"
	WIFI5_SECTION="$FOUND_SECTION"
	return 0
}

capture_target_port_network() {
	local section ports
	TARGET_PREVIOUS_NETWORK="unknown"

	find_section_one network device name br-lan-wan2
	section="$FOUND_SECTION"
	ports="$(uci -q get network.$section.ports)"
	case " $ports " in
		*" $LAN4_PORT "*) TARGET_PREVIOUS_NETWORK="lan_wan2"; return 0 ;;
	esac

	find_section_one network device name br-lan
	section="$FOUND_SECTION"
	ports="$(uci -q get network.$section.ports)"
	case " $ports " in
		*" $LAN4_PORT "*) TARGET_PREVIOUS_NETWORK="lan" ;;
	esac
}

capture_wireless_networks() {
	WIFI24_PREVIOUS_NETWORK="$(uci -q get wireless.$WIFI24_SECTION.network)"
	WIFI24_PREVIOUS_NETWORK="${WIFI24_PREVIOUS_NETWORK:-unknown}"
	if [ -n "$WIFI5_SECTION" ]; then
		WIFI5_PREVIOUS_NETWORK="$(uci -q get wireless.$WIFI5_SECTION.network)"
		WIFI5_PREVIOUS_NETWORK="${WIFI5_PREVIOUS_NETWORK:-unknown}"
	else
		WIFI5_PREVIOUS_NETWORK="absent"
	fi
}

detect_target_port_move() {
	if [ "$TARGET_PREVIOUS_NETWORK" != "$LAN4_NETWORK" ]; then
		TARGET_PORT_MOVED=1
	else
		TARGET_PORT_MOVED=0
	fi
}

detect_wireless_moves() {
	[ "$WIFI24_PREVIOUS_NETWORK" = "$WIFI24_NETWORK" ] || WIFI24_MOVED=1
	if [ -n "$WIFI5_SECTION" ] && [ "$WIFI5_PREVIOUS_NETWORK" != "$WIFI5_NETWORK" ]; then
		WIFI5_MOVED=1
	fi
}

target_port_exists() {
	[ -e "/sys/class/net/$LAN4_PORT" ]
}

set_target_port_link_state() {
	ip link set dev "$LAN4_PORT" "$1"
}

set_wireless_radio_state() {
	wifi "$1" "$2"
}

reset_target_port_link() {
	[ "$TARGET_PORT_MOVED" = "1" ] || return 0
	target_port_exists || {
		log "目标端口 $LAN4_PORT 不存在，无法执行自动链路重置"
		return 1
	}

	log "目标端口 $LAN4_PORT 已从 $TARGET_PREVIOUS_NETWORK 切换到 $LAN4_NETWORK，执行软件链路重置"
	set_target_port_link_state down || {
		log "目标端口 $LAN4_PORT 自动断开失败"
		return 1
	}
	sleep 3
	set_target_port_link_state up || {
		log "目标端口 $LAN4_PORT 自动恢复失败"
		return 1
	}
	log "目标端口 $LAN4_PORT 链路已恢复，客户端将重新获取 DHCP/IPv6 配置"
}

reset_moved_wireless() {
	local radio radios=""
	[ "$WIFI24_MOVED" = "1" ] && radios="$WIFI24_RADIO"
	if [ "$WIFI5_MOVED" = "1" ]; then
		case " $radios " in
			*" $WIFI5_RADIO "*) ;;
			*) radios="${radios:+$radios }$WIFI5_RADIO" ;;
		esac
	fi
	[ -n "$radios" ] || return 0

	for radio in $radios; do
		log "无线 $radio 出口网络已改变，执行自动断开重连"
		set_wireless_radio_state down "$radio" || {
			log "无线 $radio 自动断开失败"
			continue
		}
		sleep 2
		set_wireless_radio_state up "$radio" || {
			log "无线 $radio 自动恢复失败"
			continue
		}
		log "无线 $radio 已恢复，客户端将重新获取 DHCP/IPv6 配置"
	done
}

adopt_managed_sections() {
	local index target
	adopt_section_one network device mwan_br_lan name br-lan
	adopt_section_one network device mwan_br_lan_wan2 name br-lan-wan2

	adopt_section_one firewall zone mwan_lan_wan2_zone name lan_wan2
	adopt_section_one firewall zone mwan_wan2_zone name wan2
	adopt_section_two firewall forwarding mwan_lan_to_wan src lan dest wan
	adopt_section_two firewall forwarding mwan_lan_wan2_to_wan2 src lan_wan2 dest wan2
	adopt_section_two firewall forwarding mwan_lan_to_lan_wan2 src lan dest lan_wan2
	adopt_section_two firewall forwarding mwan_wan_to_lan_wan2 src wan dest lan_wan2
	adopt_section_two firewall forwarding mwan_lan_wan2_to_lan src lan_wan2 dest lan
	adopt_section_two firewall forwarding mwan_vpn_to_wan2 src vpn dest wan2

	adopt_section_one firewall rule mwan_allow_dhcp_renew_wan2 name Allow-DHCP-Renew-WAN2
	adopt_section_one firewall rule mwan_allow_dhcpv6_wan2 name Allow-DHCPv6-WAN2
	adopt_section_one firewall rule mwan_allow_mld_wan2 name Allow-MLD-WAN2
	adopt_section_one firewall rule mwan_allow_icmpv6_input_wan2 name Allow-ICMPv6-Input-WAN2
	adopt_section_one firewall rule mwan_allow_icmpv6_forward_wan2 name Allow-ICMPv6-Forward-WAN2
	adopt_section_one firewall rule blockvpntowan1 name Block-OpenVPN-to-WAN1
	adopt_section_one firewall rule blockvpntowan2 name Block-OpenVPN-to-WAN2
	adopt_section_one firewall rule mwan_block_lan_to_lan_wan2 name Block-MainLAN-to-WAN2-Clients
	adopt_section_one firewall rule mwan_block_wan_to_lan_wan2 name Block-WAN1-Upstream-to-LastLAN
	adopt_section_one firewall rule mwan_luna_ipv6_access name Allow-Managed-Device-IPv6

	[ "$MANAGE_LUNA" = "1" ] || return 0
	adopt_section_one dhcp host mwan_luna_v4 mac "$LUNA_MAC"
	[ "$LUNA_IPV4_PORT_FORWARD" = "1" ] && \
		adopt_section_one firewall redirect mwan_luna_ipv4_redirect src_dport "$LUNA_IPV4_PORT"

	index=0
	for target in $LUNA_ROUTES; do
		index=$((index + 1))
		adopt_section_one network route "mwan_luna_route_$index" target "$target"
	done
}


cleanup_fixed_device_ipv6() {
	# Never recreate the old DUID-based IPv6 lease or its former fixed-device
	# rule. The separately managed IPv6 access rule uses a different section.
	uci_delete_section dhcp mwan_luna_v6
	uci_delete_section firewall mwan_luna_ipv6
}

cleanup_legacy_luna_redirects() {
	local section
	for section in $(list_sections firewall redirect); do
		case "$section" in
			mwan_luna_[0-9]*) uci_delete_section firewall "$section" ;;
		esac
	done
}

cleanup_fixed_device_ipv4() {
	local section
	uci_delete_section dhcp mwan_luna
	uci_delete_section dhcp mwan_luna_v4
	uci_delete_section firewall mwan_luna_ipv4_redirect
	cleanup_legacy_luna_redirects
	uci_delete_section firewall allow_wan1_to_lan4_device

	for section in $(list_sections network route); do
		case "$section" in
			mwan_luna_route_*) uci_delete_section network "$section" ;;
		esac
	done
}

apply_luna_ipv4() {
	local index target section keep current
	cleanup_fixed_device_ipv6
	if [ "$MANAGE_LUNA" != "1" ]; then
		cleanup_fixed_device_ipv4
		return 0
	fi

	# A pre-Release-12 combined host may still contain DUID/hostid. The adopted
	# IPv4 host deliberately keeps only the MAC reservation and IPv4 address.
	uci_delete_section dhcp mwan_luna
	uci_set_type dhcp mwan_luna_v4 host
	uci_set_value dhcp mwan_luna_v4 name ManagedDevice
	uci_set_list dhcp mwan_luna_v4 mac "$LUNA_MAC"
	uci_set_value dhcp mwan_luna_v4 ip "$LUNA_IPV4"
	uci_delete_option dhcp mwan_luna_v4 duid
	uci_delete_option dhcp mwan_luna_v4 hostid

	index=0
	for target in $LUNA_ROUTES; do
		index=$((index + 1))
		section="mwan_luna_route_$index"
		uci_set_type network "$section" route
		uci_set_value network "$section" target "$target"
		uci_set_value network "$section" gateway "$LUNA_IPV4"
		uci_set_value network "$section" interface "$LUNA_NETWORK"
	done

	for section in $(list_sections network route); do
		case "$section" in
			mwan_luna_route_*)
				keep=0
				current="${section#mwan_luna_route_}"
				[ "$current" -le "$index" ] 2>/dev/null && keep=1
				[ "$keep" = "1" ] || uci_delete_section network "$section"
				;;
		esac
	done

	if [ "$LUNA_IPV4_PORT_FORWARD" = "1" ]; then
		cleanup_legacy_luna_redirects
		uci_set_type firewall mwan_luna_ipv4_redirect redirect
		uci_set_value firewall mwan_luna_ipv4_redirect name Managed-Device-IPv4-Port-Forward
		uci_set_value firewall mwan_luna_ipv4_redirect target DNAT
		uci_set_value firewall mwan_luna_ipv4_redirect src "$LUNA_SOURCE_ZONE"
		uci_set_value firewall mwan_luna_ipv4_redirect dest "$LUNA_DEST_ZONE"
		uci_set_value firewall mwan_luna_ipv4_redirect proto 'tcp udp'
		uci_set_value firewall mwan_luna_ipv4_redirect src_dport "$LUNA_IPV4_PORT"
		uci_set_value firewall mwan_luna_ipv4_redirect dest_port "$LUNA_IPV4_PORT"
		uci_set_value firewall mwan_luna_ipv4_redirect dest_ip "$LUNA_IPV4"
		uci_set_value firewall mwan_luna_ipv4_redirect family ipv4
	else
		uci_delete_section firewall mwan_luna_ipv4_redirect
		cleanup_legacy_luna_redirects
	fi
	# WAN1-upstream access is managed centrally by lan_access_target for the whole
	# last-LAN zone. Remove the old fixed-device-only rule so it cannot bypass the
	# current allow/reject policy.
	uci_delete_section firewall allow_wan1_to_lan4_device
}

apply_luna_ipv6_firewall() {
	if [ "$LUNA_IPV6_FIREWALL" != "1" ]; then
		uci_delete_section firewall mwan_luna_ipv6_access
		return 0
	fi

	uci_set_type firewall mwan_luna_ipv6_access rule
	# A rule disabled from LuCI keeps option enabled='0' even when its managed
	# switch is later turned back on. Remove that stale per-rule override.
	uci_delete_option firewall mwan_luna_ipv6_access enabled
	uci_set_value firewall mwan_luna_ipv6_access name Allow-Managed-Device-IPv6
	uci_set_value firewall mwan_luna_ipv6_access src "$LUNA_SOURCE_ZONE"
	uci_set_value firewall mwan_luna_ipv6_access dest "$LUNA_DEST_ZONE"
	uci_set_value firewall mwan_luna_ipv6_access family ipv6
	uci_set_value firewall mwan_luna_ipv6_access proto 'tcp udp'
	uci_set_value firewall mwan_luna_ipv6_access dest_port "$LUNA_IPV6_PORTS"
	uci_set_value firewall mwan_luna_ipv6_access target ACCEPT
	uci_set_list firewall mwan_luna_ipv6_access dest_ip "$LUNA_IPV6_DEST_IP"
}

order_access_firewall_rules() {
	local section first_rule_position=-1 count=0
	# firewall3 and firewall4 both evaluate traffic rules in UCI order. Put the
	# broad reject ahead of unrelated allows, while keeping the managed IPv6 port
	# exception immediately before it.
	[ "$MODE" = "dual" ] || return 0
	[ "$LAN_ACCESS_TARGET" = "0" ] || return 0
	for section in $(list_all_sections firewall); do
		if [ "$(uci -q get firewall.$section)" = "rule" ]; then
			first_rule_position="$count"
			break
		fi
		count=$((count + 1))
	done
	[ "$first_rule_position" -ge 0 ] || return 1
	move_section_to_position firewall mwan_block_wan_to_lan_wan2 "$first_rule_position" || return 1
	if [ "$LUNA_IPV6_FIREWALL" = "1" ]; then
		move_section_to_position firewall mwan_luna_ipv6_access "$first_rule_position" || return 1
	fi
}

apply_common_network() {
	uci_set_type network mwan_br_lan device
	uci_set_value network mwan_br_lan name br-lan
	uci_set_value network mwan_br_lan type bridge

	uci_set_type network wan6 interface
	uci_set_value network wan6 device @wan
	uci_set_value network wan6 proto dhcpv6
	uci_set_value network wan6 reqaddress try
	uci_set_value network wan6 reqprefix auto
	uci_set_value network wan6 sourcefilter 1

	uci_set_type network lan interface
	uci_set_list network lan ip6class wan6
}

apply_dual_network() {
	local port option
	uci_delete_section network wan2_probe
	uci_del_list_value network mwan_br_lan ports "$WAN2_PORT"

	uci_set_type network mwan_br_lan_wan2 device
	uci_set_value network mwan_br_lan_wan2 name br-lan-wan2
	uci_set_value network mwan_br_lan_wan2 type bridge
	uci_set_value network mwan_br_lan_wan2 bridge_empty 1
	uci_set_value network mwan_br_lan_wan2 igmp_snooping 0
	uci_set_value network mwan_br_lan_wan2 multicast_querier 0
	uci_del_list_value network mwan_br_lan_wan2 ports "$WAN2_PORT"

	# 目标端口改变时，将原来留在 WAN2 内网桥的其它 LAN 口自动归回主 LAN。
	for port in $DETECTED_LAN_PORTS; do
		[ "$port" = "$WAN2_PORT" ] && continue
		[ "$port" = "$LAN4_PORT" ] && continue
		uci_del_list_value network mwan_br_lan_wan2 ports "$port"
		uci_add_list_once network mwan_br_lan ports "$port"
	done

	if [ "$LAN4_UPLINK" = "wan2" ]; then
		uci_del_list_value network mwan_br_lan ports "$LAN4_PORT"
		uci_add_list_once network mwan_br_lan_wan2 ports "$LAN4_PORT"
		LAN4_NETWORK="lan_wan2"
	else
		uci_del_list_value network mwan_br_lan_wan2 ports "$LAN4_PORT"
		uci_add_list_once network mwan_br_lan ports "$LAN4_PORT"
		LAN4_NETWORK="lan"
	fi

	uci_set_type network lan_wan2 interface
	uci_set_value network lan_wan2 device br-lan-wan2
	uci_set_value network lan_wan2 proto static
	uci_set_value network lan_wan2 ipaddr "$WAN2_LAN_IP"
	uci_set_value network lan_wan2 netmask 255.255.255.0
	if [ "$WAN2_IPV6" = "1" ]; then
		uci_set_value network lan_wan2 ip6assign 64
		uci_set_list network lan_wan2 ip6class wan2_6
	else
		uci_delete_option network lan_wan2 ip6assign
		uci_delete_option network lan_wan2 ip6class
	fi

	uci_set_type network wan2 interface
	uci_set_value network wan2 device "$WAN2_PORT"
	uci_set_value network wan2 proto "$WAN2_PROTO"
	uci_set_value network wan2 ip4table "$WAN2_TABLE"
	[ "$WAN2_DNS_MODE" = "custom" ] && uci_set_value network wan2 peerdns 0

	# Release 11 exposed these PPPoE knobs. Remove only the app-owned options so
	# pppd/netifd can use their protocol defaults from now on.
	for option in mtu keepalive holdoff persist maxfail service ac reqprefix; do
		uci_delete_option network wan2 "$option"
	done

	if [ "$WAN2_PROTO" = "pppoe" ]; then
		uci_set_value network wan2 username "$WAN2_PPPOE_USERNAME"
		uci_set_value network wan2 password "$WAN2_PPPOE_PASSWORD"
		uci_delete_section network wan2_6
		if [ "$WAN2_IPV6" = "1" ]; then
			# Missing ipv6 means "auto" for OpenWrt PPP protocols. ppp6-up then
			# recreates the dynamic wan2_6 DHCPv6 client after every reconnect.
			uci_delete_option network wan2 ipv6
			uci_set_value network wan2 ip6table "$WAN2_TABLE"
		else
			uci_set_value network wan2 ipv6 0
			uci_delete_option network wan2 ip6table
		fi
	else
		uci_delete_option network wan2 username
		uci_delete_option network wan2 password
		uci_delete_option network wan2 ipv6
		uci_delete_option network wan2 ip6table
		if [ "$WAN2_IPV6" = "1" ]; then
			uci_set_type network wan2_6 interface
			uci_set_value network wan2_6 device @wan2
			uci_set_value network wan2_6 proto dhcpv6
			uci_set_value network wan2_6 reqaddress try
			uci_set_value network wan2_6 reqprefix auto
			uci_set_value network wan2_6 ip6table "$WAN2_TABLE"
			[ "$WAN2_DNS_MODE" = "custom" ] && uci_set_value network wan2_6 peerdns 0
			uci_set_value network wan2_6 sourcefilter 1
		else
			uci_delete_section network wan2_6
		fi
	fi

	uci_set_type network lan_wan2_internal_ipv4 rule
	uci_set_value network lan_wan2_internal_ipv4 in lan_wan2
	uci_set_value network lan_wan2_internal_ipv4 lookup main
	uci_set_value network lan_wan2_internal_ipv4 suppress_prefixlength 0
	uci_set_value network lan_wan2_internal_ipv4 priority 10500

	uci_set_type network lan_wan2_ipv4 rule
	uci_set_value network lan_wan2_ipv4 in lan_wan2
	uci_set_value network lan_wan2_ipv4 lookup "$WAN2_TABLE"
	uci_set_value network lan_wan2_ipv4 priority 11000

	if [ "$WAN2_IPV6" = "1" ]; then
		if [ "$LAN4_UPLINK" = "wan2" ] && [ "$LUNA_IPV6_FIREWALL" = "1" ]; then
			uci_set_type network lan_wan2_return_ipv6 rule6
			for option in disabled in out src dest tos uidrange ipproto invert \
				action goto suppress_prefixlength; do
				uci_delete_option network lan_wan2_return_ipv6 "$option"
			done
			uci_set_value network lan_wan2_return_ipv6 mark 0x20000/0x20000
			uci_set_value network lan_wan2_return_ipv6 lookup "$WAN2_TABLE"
			uci_set_value network lan_wan2_return_ipv6 priority 10400
		else
			uci_delete_section network lan_wan2_return_ipv6
		fi

		uci_set_type network lan_wan2_internal_ipv6 rule6
		uci_set_value network lan_wan2_internal_ipv6 in lan_wan2
		uci_set_value network lan_wan2_internal_ipv6 lookup main
		uci_set_value network lan_wan2_internal_ipv6 suppress_prefixlength 0
		uci_set_value network lan_wan2_internal_ipv6 priority 10500

		uci_set_type network lan_wan2_ipv6 rule6
		uci_set_value network lan_wan2_ipv6 in lan_wan2
		uci_set_value network lan_wan2_ipv6 lookup "$WAN2_TABLE"
		uci_set_value network lan_wan2_ipv6 priority 11000
	else
		uci_delete_section network lan_wan2_return_ipv6
		uci_delete_section network lan_wan2_internal_ipv6
		uci_delete_section network lan_wan2_ipv6
	fi
}

apply_single_network() {
	local port
	for port in $DETECTED_LAN_PORTS; do
		if [ "$WAN2_FAILOVER_ACTIVE" = "1" ] && [ "$CONFIG_MODE" = "dual" ] && [ "$port" = "$WAN2_PORT" ]; then
			continue
		fi
		uci_add_list_once network mwan_br_lan ports "$port"
	done
	uci_add_list_once network mwan_br_lan ports "$LAN4_PORT"

	if [ "$WAN2_FAILOVER_ACTIVE" = "1" ] && [ "$CONFIG_MODE" = "dual" ]; then
		# 自动故障期间保持 WAN2 口隔离并置为 proto none，以便安全检测重新插线。
		uci_del_list_value network mwan_br_lan ports "$WAN2_PORT"
		uci_set_type network wan2_probe interface
		uci_set_value network wan2_probe device "$WAN2_PORT"
		uci_set_value network wan2_probe proto none
		uci_set_value network wan2_probe force_link 1
	else
		uci_add_list_once network mwan_br_lan ports "$WAN2_PORT"
		uci_delete_section network wan2_probe
	fi

	uci_delete_section network lan_wan2_internal_ipv4
	uci_delete_section network lan_wan2_internal_ipv6
	uci_delete_section network lan_wan2_return_ipv6
	uci_delete_section network lan_wan2_ipv4
	uci_delete_section network lan_wan2_ipv6
	uci_delete_section network wan2_6
	uci_delete_section network wan2
	uci_delete_section network lan_wan2
	uci_delete_section network mwan_br_lan_wan2

	LAN4_NETWORK="lan"
}

apply_wireless() {
	if [ "$MODE" = "dual" ] && [ "$WIFI24_UPLINK" = "wan2" ]; then
		WIFI24_NETWORK="lan_wan2"
	else
		WIFI24_NETWORK="lan"
	fi
	if [ "$MODE" = "dual" ] && [ "$WIFI5_UPLINK" = "wan2" ]; then
		WIFI5_NETWORK="lan_wan2"
	else
		WIFI5_NETWORK="lan"
	fi

	uci_set_value wireless "$WIFI24_SECTION" network "$WIFI24_NETWORK"
	[ -n "$WIFI5_SECTION" ] && uci_set_value wireless "$WIFI5_SECTION" network "$WIFI5_NETWORK"
}

apply_common_dhcp() {
	uci_set_type dhcp lan dhcp
	if [ "$LAN_DNS_MODE" = "custom" ]; then
		uci_replace_list_prefix dhcp lan dhcp_option 6, "6,$(printf '%s' "$LAN_DNS4" | tr ' ' ',')"
		uci_set_list dhcp lan dns $LAN_DNS6
	fi
	uci_set_value dhcp lan dhcpv6 server
	uci_set_value dhcp lan dhcpv6_na 1
	uci_set_value dhcp lan ra server
	uci_set_value dhcp lan ra_slaac 1
	# firewall3-era odhcpd reads ra_management; newer releases use ra_flags.
	# Keeping both makes the M/A flags explicit across both generations.
	uci_set_value dhcp lan ra_management 1
	uci_set_list dhcp lan ra_flags managed-config other-config
	uci_delete_option dhcp lan max_preferred_lifetime
	uci_delete_option dhcp lan max_valid_lifetime
}

apply_dual_dhcp() {
	uci_set_type dhcp lan_wan2 dhcp
	uci_set_value dhcp lan_wan2 interface lan_wan2
	uci_set_value dhcp lan_wan2 start 100
	uci_set_value dhcp lan_wan2 limit 150
	uci_set_value dhcp lan_wan2 leasetime 12h
	uci_set_value dhcp lan_wan2 dhcpv4 server
	uci_delete_option dhcp lan_wan2 max_preferred_lifetime
	uci_delete_option dhcp lan_wan2 max_valid_lifetime
	if [ "$WAN2_IPV6" = "1" ]; then
		uci_set_value dhcp lan_wan2 dhcpv6 server
		uci_set_value dhcp lan_wan2 dhcpv6_na 1
		uci_set_value dhcp lan_wan2 ra server
		uci_set_value dhcp lan_wan2 ra_slaac 1
		uci_set_value dhcp lan_wan2 ra_management 1
		uci_set_list dhcp lan_wan2 ra_flags managed-config other-config
	else
		uci_set_value dhcp lan_wan2 dhcpv6 disabled
		uci_set_value dhcp lan_wan2 ra disabled
		uci_delete_option dhcp lan_wan2 dhcpv6_na
		uci_delete_option dhcp lan_wan2 ra_slaac
		uci_delete_option dhcp lan_wan2 ra_management
		uci_delete_option dhcp lan_wan2 ra_flags
	fi
	if [ "$WAN2_DNS_MODE" = "custom" ]; then
		uci_replace_list_prefix dhcp lan_wan2 dhcp_option 6, "6,$(printf '%s' "$WAN2_DNS4" | tr ' ' ',')"
		if [ "$WAN2_IPV6" = "1" ]; then
			uci_set_list dhcp lan_wan2 dns $WAN2_DNS6
		else
			uci_delete_option dhcp lan_wan2 dns
		fi
	fi

	uci_set_type dhcp wan2 dhcp
	uci_set_value dhcp wan2 interface wan2
	uci_set_value dhcp wan2 ignore 1
	if [ "$WAN2_IPV6" = "1" ]; then
		uci_set_type dhcp wan2_6 dhcp
		uci_set_value dhcp wan2_6 interface wan2_6
		uci_set_value dhcp wan2_6 ignore 1
	else
		uci_delete_section dhcp wan2_6
	fi
}

apply_single_dhcp() {
	uci_delete_section dhcp lan_wan2
	uci_delete_section dhcp wan2
	uci_delete_section dhcp wan2_6
}

ensure_wan2_rule_dhcp4() {
	uci_set_type firewall mwan_allow_dhcp_renew_wan2 rule
	uci_set_value firewall mwan_allow_dhcp_renew_wan2 name Allow-DHCP-Renew-WAN2
	uci_set_value firewall mwan_allow_dhcp_renew_wan2 src wan2
	uci_set_value firewall mwan_allow_dhcp_renew_wan2 proto udp
	uci_set_value firewall mwan_allow_dhcp_renew_wan2 dest_port 68
	uci_set_value firewall mwan_allow_dhcp_renew_wan2 target ACCEPT
	uci_set_value firewall mwan_allow_dhcp_renew_wan2 family ipv4
}

ensure_wan2_rule_dhcp6() {
	uci_set_type firewall mwan_allow_dhcpv6_wan2 rule
	uci_set_value firewall mwan_allow_dhcpv6_wan2 name Allow-DHCPv6-WAN2
	uci_set_value firewall mwan_allow_dhcpv6_wan2 src wan2
	uci_set_value firewall mwan_allow_dhcpv6_wan2 proto udp
	uci_set_value firewall mwan_allow_dhcpv6_wan2 dest_port 546
	uci_set_value firewall mwan_allow_dhcpv6_wan2 family ipv6
	uci_set_value firewall mwan_allow_dhcpv6_wan2 target ACCEPT
}

ensure_wan2_rule_mld() {
	uci_set_type firewall mwan_allow_mld_wan2 rule
	uci_set_value firewall mwan_allow_mld_wan2 name Allow-MLD-WAN2
	uci_set_value firewall mwan_allow_mld_wan2 src wan2
	uci_set_value firewall mwan_allow_mld_wan2 proto icmp
	uci_set_value firewall mwan_allow_mld_wan2 src_ip fe80::/10
	uci_set_list firewall mwan_allow_mld_wan2 icmp_type 130/0 131/0 132/0 143/0
	uci_set_value firewall mwan_allow_mld_wan2 family ipv6
	uci_set_value firewall mwan_allow_mld_wan2 target ACCEPT
}

ensure_wan2_rule_icmp_input() {
	uci_set_type firewall mwan_allow_icmpv6_input_wan2 rule
	uci_set_value firewall mwan_allow_icmpv6_input_wan2 name Allow-ICMPv6-Input-WAN2
	uci_set_value firewall mwan_allow_icmpv6_input_wan2 src wan2
	uci_set_value firewall mwan_allow_icmpv6_input_wan2 proto icmp
	uci_set_list firewall mwan_allow_icmpv6_input_wan2 icmp_type \
		echo-request echo-reply destination-unreachable packet-too-big time-exceeded \
		bad-header unknown-header-type router-solicitation neighbour-solicitation \
		router-advertisement neighbour-advertisement
	uci_set_value firewall mwan_allow_icmpv6_input_wan2 limit 1000/sec
	uci_set_value firewall mwan_allow_icmpv6_input_wan2 family ipv6
	uci_set_value firewall mwan_allow_icmpv6_input_wan2 target ACCEPT
}

ensure_wan2_rule_icmp_forward() {
	uci_set_type firewall mwan_allow_icmpv6_forward_wan2 rule
	uci_set_value firewall mwan_allow_icmpv6_forward_wan2 name Allow-ICMPv6-Forward-WAN2
	uci_set_value firewall mwan_allow_icmpv6_forward_wan2 src wan2
	uci_set_value firewall mwan_allow_icmpv6_forward_wan2 dest '*'
	uci_set_value firewall mwan_allow_icmpv6_forward_wan2 proto icmp
	uci_set_list firewall mwan_allow_icmpv6_forward_wan2 icmp_type \
		echo-request echo-reply destination-unreachable packet-too-big time-exceeded \
		bad-header unknown-header-type
	uci_set_value firewall mwan_allow_icmpv6_forward_wan2 limit 1000/sec
	uci_set_value firewall mwan_allow_icmpv6_forward_wan2 family ipv6
	uci_set_value firewall mwan_allow_icmpv6_forward_wan2 target ACCEPT
}

apply_common_firewall() {
	local vpn_zone
	ensure_forwarding mwan_lan_to_wan lan wan

	uci_set_type firewall mwan_switch_return_path include
	uci_delete_option firewall mwan_switch_return_path enabled
	uci_delete_option firewall mwan_switch_return_path family
	uci_delete_option firewall mwan_switch_return_path position
	uci_delete_option firewall mwan_switch_return_path chain
	uci_set_value firewall mwan_switch_return_path type script
	uci_set_value firewall mwan_switch_return_path path "$RETURN_PATH_HELPER"
	# reload is a firewall3-only include option. firewall4 reports it as
	# unsupported, and the app invokes the helper explicitly after applying UCI.
	if command -v fw4 >/dev/null 2>&1; then
		uci_delete_option firewall mwan_switch_return_path reload
	else
		uci_set_value firewall mwan_switch_return_path reload 1
	fi
	uci_set_value firewall mwan_switch_return_path fw4_compatible 1

	find_section_one firewall zone name vpn
	vpn_zone="$FOUND_SECTION"
	if [ -z "$vpn_zone" ]; then
		vpn_zone="mwan_vpn_zone"
		uci_set_type firewall "$vpn_zone" zone
		uci_set_value firewall "$vpn_zone" name vpn
		uci_set_value firewall "$vpn_zone" input ACCEPT
		uci_set_value firewall "$vpn_zone" output ACCEPT
		uci_set_value firewall "$vpn_zone" forward ACCEPT
		uci_set_value firewall "$vpn_zone" masq 1
	fi
	uci_add_list_once firewall "$vpn_zone" device 'tun+'
	if [ "$VPN_WAN1_ISOLATION" = "1" ]; then
		delete_forwardings vpn wan
		uci_set_type firewall blockvpntowan1 rule
		uci_set_value firewall blockvpntowan1 name Block-OpenVPN-to-WAN1
		uci_set_value firewall blockvpntowan1 src vpn
		uci_set_value firewall blockvpntowan1 dest wan
		uci_set_value firewall blockvpntowan1 target REJECT
	else
		uci_delete_section firewall blockvpntowan1
		ensure_forwarding vpntowan vpn wan
	fi
}

apply_dual_firewall() {
	local option
	uci_set_type firewall mwan_lan_wan2_zone zone
	uci_set_value firewall mwan_lan_wan2_zone name lan_wan2
	uci_set_list firewall mwan_lan_wan2_zone network lan_wan2
	uci_set_value firewall mwan_lan_wan2_zone input ACCEPT
	uci_set_value firewall mwan_lan_wan2_zone output ACCEPT
	uci_set_value firewall mwan_lan_wan2_zone forward ACCEPT
	# A network assigned to both the main LAN zone and this dedicated zone can
	# bypass the intended one-way forwarding policy. Remove stale/manual duplicate
	# membership before creating the explicit lan -> lan_wan2 forwarding.
	remove_network_from_other_zones lan_wan2 mwan_lan_wan2_zone

	uci_set_type firewall mwan_wan2_zone zone
	uci_set_value firewall mwan_wan2_zone name wan2
	if [ "$WAN2_IPV6" = "1" ]; then
		uci_set_list firewall mwan_wan2_zone network wan2 wan2_6
	else
		uci_set_list firewall mwan_wan2_zone network wan2
	fi
	uci_set_value firewall mwan_wan2_zone input REJECT
	uci_set_value firewall mwan_wan2_zone output ACCEPT
	uci_set_value firewall mwan_wan2_zone forward REJECT
	uci_set_value firewall mwan_wan2_zone masq 1
	uci_set_value firewall mwan_wan2_zone mtu_fix 1

	ensure_forwarding mwan_lan_wan2_to_wan2 lan_wan2 wan2
	# Main-LAN clients keep one-way access to the last-LAN network. The page
	# selector below controls WAN1-upstream access independently.
	uci_delete_section firewall mwan_block_lan_to_lan_wan2
	ensure_forwarding mwan_lan_to_lan_wan2 lan lan_wan2
	if [ "$LAN_ACCESS_TARGET" = "1" ]; then
		uci_delete_section firewall mwan_block_wan_to_lan_wan2
		ensure_forwarding mwan_wan_to_lan_wan2 wan lan_wan2
	else
		# The explicit reject is required on vendor configurations whose global
		# forwarding policy is ACCEPT. A managed IPv6 port allow rule is ordered
		# before this broad reject after all firewall sections are generated.
		delete_forwardings wan lan_wan2
		uci_set_type firewall mwan_block_wan_to_lan_wan2 rule
		uci_set_value firewall mwan_block_wan_to_lan_wan2 name Block-WAN1-Upstream-to-LastLAN
		uci_set_value firewall mwan_block_wan_to_lan_wan2 src wan
		uci_set_value firewall mwan_block_wan_to_lan_wan2 dest lan_wan2
		uci_set_value firewall mwan_block_wan_to_lan_wan2 target REJECT
		# Keep this a broad IPv4/IPv6, all-protocol reject. Remove any stale match
		# restriction if a same-name rule from an older/manual setup was adopted.
		for option in enabled family proto src_ip dest_ip src_port dest_port \
			icmp_type ipset mark limit limit_burst weekdays monthdays \
			start_date stop_date start_time stop_time utc_time; do
			uci_delete_option firewall mwan_block_wan_to_lan_wan2 "$option"
		done
	fi
	# Do not let devices behind the last port initiate connections to either LAN.
	delete_forwardings lan_wan2 lan
	delete_forwardings lan_wan2 wan

	if [ "$WAN2_PROTO" = "dhcp" ]; then
		ensure_wan2_rule_dhcp4
	else
		uci_delete_section firewall mwan_allow_dhcp_renew_wan2
	fi
	if [ "$WAN2_IPV6" = "1" ]; then
		ensure_wan2_rule_dhcp6
		ensure_wan2_rule_mld
		ensure_wan2_rule_icmp_input
		ensure_wan2_rule_icmp_forward
	else
		uci_delete_section firewall mwan_allow_dhcpv6_wan2
		uci_delete_section firewall mwan_allow_mld_wan2
		uci_delete_section firewall mwan_allow_icmpv6_input_wan2
		uci_delete_section firewall mwan_allow_icmpv6_forward_wan2
	fi

	if [ "$VPN_WAN2_ISOLATION" = "1" ]; then
		delete_forwardings vpn wan2
		uci_set_type firewall blockvpntowan2 rule
		uci_set_value firewall blockvpntowan2 name Block-OpenVPN-to-WAN2
		uci_set_value firewall blockvpntowan2 src vpn
		uci_set_value firewall blockvpntowan2 dest wan2
		uci_set_value firewall blockvpntowan2 target REJECT
	else
		uci_delete_section firewall blockvpntowan2
		ensure_forwarding mwan_vpn_to_wan2 vpn wan2
	fi
}

apply_single_firewall() {
	uci_delete_section firewall mwan_lan_wan2_to_wan2
	delete_forwardings lan lan_wan2
	uci_delete_section firewall mwan_block_lan_to_lan_wan2
	delete_forwardings wan lan_wan2
	uci_delete_section firewall mwan_block_wan_to_lan_wan2
	delete_forwardings lan_wan2 lan
	delete_forwardings lan_wan2 wan
	uci_delete_section firewall mwan_allow_dhcp_renew_wan2
	uci_delete_section firewall mwan_allow_dhcpv6_wan2
	uci_delete_section firewall mwan_allow_mld_wan2
	uci_delete_section firewall mwan_allow_icmpv6_input_wan2
	uci_delete_section firewall mwan_allow_icmpv6_forward_wan2
	uci_delete_section firewall blockvpntowan2
	uci_delete_section firewall mwan_vpn_to_wan2
	uci_delete_section firewall mwan_wan2_zone
	uci_delete_section firewall mwan_lan_wan2_zone
}

commit_and_reload() {
	[ "$NETWORK_CHANGED" = "1" ] && uci commit network
	[ "$DHCP_CHANGED" = "1" ] && uci commit dhcp
	[ "$FIREWALL_CHANGED" = "1" ] && uci commit firewall
	[ "$WIRELESS_CHANGED" = "1" ] && uci commit wireless

	if [ "$NETWORK_CHANGED" = "1" ]; then
		/etc/init.d/network reload
	fi
	if [ "$FIREWALL_CHANGED" = "1" ] || [ "$NETWORK_CHANGED" = "1" ]; then
		/etc/init.d/firewall restart
	fi
	if [ "$DHCP_CHANGED" = "1" ] || [ "$NETWORK_CHANGED" = "1" ]; then
		/etc/init.d/dnsmasq restart
		/etc/init.d/odhcpd restart
	fi
	if [ "$WIRELESS_CHANGED" = "1" ] || [ "$NETWORK_CHANGED" = "1" ]; then
		wifi reload
	fi
}

check_luna_ipv4_state() {
	local index=0 target section route_count=0

	# The former DUID-based fixed-device state must remain absent. The current
	# IPv6 access rule is checked separately below.
	uci -q get dhcp.mwan_luna_v6 >/dev/null && return 1
	uci -q get firewall.mwan_luna_ipv6 >/dev/null && return 1
	uci -q get dhcp.mwan_luna >/dev/null && return 1
	for section in $(list_sections firewall redirect); do
		case "$section" in mwan_luna_[0-9]*) return 1 ;; esac
	done

	if [ "$MANAGE_LUNA" != "1" ]; then
		uci -q get dhcp.mwan_luna_v4 >/dev/null && return 1
		uci -q get firewall.mwan_luna_ipv4_redirect >/dev/null && return 1
		uci -q get firewall.allow_wan1_to_lan4_device >/dev/null && return 1
		for section in $(list_sections network route); do
			case "$section" in mwan_luna_route_*) return 1 ;; esac
		done
		return 0
	fi

	[ "$(uci -q get dhcp.mwan_luna_v4)" = "host" ] || return 1
	[ "$(uci -q get dhcp.mwan_luna_v4.name)" = "ManagedDevice" ] || return 1
	[ "$(uci -q get dhcp.mwan_luna_v4.mac)" = "$LUNA_MAC" ] || return 1
	[ "$(uci -q get dhcp.mwan_luna_v4.ip)" = "$LUNA_IPV4" ] || return 1
	uci -q get dhcp.mwan_luna_v4.duid >/dev/null && return 1
	uci -q get dhcp.mwan_luna_v4.hostid >/dev/null && return 1

	for target in $LUNA_ROUTES; do
		index=$((index + 1))
		section="mwan_luna_route_$index"
		[ "$(uci -q get network.$section)" = "route" ] || return 1
		[ "$(uci -q get network.$section.target)" = "$target" ] || return 1
		[ "$(uci -q get network.$section.gateway)" = "$LUNA_IPV4" ] || return 1
		[ "$(uci -q get network.$section.interface)" = "$LUNA_NETWORK" ] || return 1
	done
	for section in $(list_sections network route); do
		case "$section" in mwan_luna_route_*) route_count=$((route_count + 1)) ;; esac
	done
	[ "$route_count" -eq "$index" ] || return 1

	if [ "$LUNA_IPV4_PORT_FORWARD" = "1" ]; then
		[ "$(uci -q get firewall.mwan_luna_ipv4_redirect)" = "redirect" ] || return 1
		[ "$(uci -q get firewall.mwan_luna_ipv4_redirect.name)" = "Managed-Device-IPv4-Port-Forward" ] || return 1
		[ "$(uci -q get firewall.mwan_luna_ipv4_redirect.target)" = "DNAT" ] || return 1
		[ "$(uci -q get firewall.mwan_luna_ipv4_redirect.src)" = "$LUNA_SOURCE_ZONE" ] || return 1
		[ "$(uci -q get firewall.mwan_luna_ipv4_redirect.dest)" = "$LUNA_DEST_ZONE" ] || return 1
		[ "$(uci -q get firewall.mwan_luna_ipv4_redirect.proto)" = "tcp udp" ] || return 1
		[ "$(uci -q get firewall.mwan_luna_ipv4_redirect.src_dport)" = "$LUNA_IPV4_PORT" ] || return 1
		[ "$(uci -q get firewall.mwan_luna_ipv4_redirect.dest_port)" = "$LUNA_IPV4_PORT" ] || return 1
		[ "$(uci -q get firewall.mwan_luna_ipv4_redirect.dest_ip)" = "$LUNA_IPV4" ] || return 1
		[ "$(uci -q get firewall.mwan_luna_ipv4_redirect.family)" = "ipv4" ] || return 1
	else
		uci -q get firewall.mwan_luna_ipv4_redirect >/dev/null && return 1
	fi

	uci -q get firewall.allow_wan1_to_lan4_device >/dev/null && return 1

	return 0
}

check_luna_ipv6_firewall_state() {
	if [ "$LUNA_IPV6_FIREWALL" != "1" ]; then
		uci -q get firewall.mwan_luna_ipv6_access >/dev/null && return 1
		return 0
	fi

	[ "$(uci -q get firewall.mwan_luna_ipv6_access)" = "rule" ] || return 1
	[ "$(uci -q get firewall.mwan_luna_ipv6_access.enabled)" != "0" ] || return 1
	[ "$(uci -q get firewall.mwan_luna_ipv6_access.name)" = "Allow-Managed-Device-IPv6" ] || return 1
	[ "$(uci -q get firewall.mwan_luna_ipv6_access.src)" = "$LUNA_SOURCE_ZONE" ] || return 1
	[ "$(uci -q get firewall.mwan_luna_ipv6_access.dest)" = "$LUNA_DEST_ZONE" ] || return 1
	[ "$(uci -q get firewall.mwan_luna_ipv6_access.family)" = "ipv6" ] || return 1
	[ "$(uci -q get firewall.mwan_luna_ipv6_access.proto)" = "tcp udp" ] || return 1
	[ "$(uci -q get firewall.mwan_luna_ipv6_access.dest_port)" = "$LUNA_IPV6_PORTS" ] || return 1
	[ "$(uci -q get firewall.mwan_luna_ipv6_access.target)" = "ACCEPT" ] || return 1
	[ "$(uci -q get firewall.mwan_luna_ipv6_access.dest_ip)" = "$LUNA_IPV6_DEST_IP" ] || return 1
	return 0
}

check_return_path_state() {
	[ "$(uci -q get firewall.mwan_switch_return_path)" = "include" ] || return 1
	[ "$(uci -q get firewall.mwan_switch_return_path.enabled)" != "0" ] || return 1
	[ "$(uci -q get firewall.mwan_switch_return_path.type)" = "script" ] || return 1
	[ "$(uci -q get firewall.mwan_switch_return_path.path)" = "$RETURN_PATH_HELPER" ] || return 1
	uci -q get firewall.mwan_switch_return_path.family >/dev/null && return 1
	uci -q get firewall.mwan_switch_return_path.position >/dev/null && return 1
	uci -q get firewall.mwan_switch_return_path.chain >/dev/null && return 1
	if command -v fw4 >/dev/null 2>&1; then
		uci -q get firewall.mwan_switch_return_path.reload >/dev/null && return 1
	else
		[ "$(uci -q get firewall.mwan_switch_return_path.reload)" = "1" ] || return 1
	fi
	[ "$(uci -q get firewall.mwan_switch_return_path.fw4_compatible)" = "1" ] || return 1
	[ -x "$RETURN_PATH_HELPER" ] || return 1
	"$RETURN_PATH_HELPER" check
}

check_lan_wan2_policy_state() {
	if [ "$MODE" != "dual" ]; then
		uci -q get network.lan_wan2_internal_ipv4 >/dev/null && return 1
		uci -q get network.lan_wan2_ipv4 >/dev/null && return 1
		uci -q get network.lan_wan2_return_ipv6 >/dev/null && return 1
		uci -q get network.lan_wan2_internal_ipv6 >/dev/null && return 1
		uci -q get network.lan_wan2_ipv6 >/dev/null && return 1
		return 0
	fi

	[ "$(uci -q get network.wan2.ip4table)" = "$WAN2_TABLE" ] || return 1
	[ "$(uci -q get network.lan_wan2_internal_ipv4)" = "rule" ] || return 1
	[ "$(uci -q get network.lan_wan2_internal_ipv4.in)" = "lan_wan2" ] || return 1
	[ "$(uci -q get network.lan_wan2_internal_ipv4.lookup)" = "main" ] || return 1
	[ "$(uci -q get network.lan_wan2_internal_ipv4.suppress_prefixlength)" = "0" ] || return 1
	[ "$(uci -q get network.lan_wan2_internal_ipv4.priority)" = "10500" ] || return 1
	[ "$(uci -q get network.lan_wan2_ipv4)" = "rule" ] || return 1
	[ "$(uci -q get network.lan_wan2_ipv4.in)" = "lan_wan2" ] || return 1
	[ "$(uci -q get network.lan_wan2_ipv4.lookup)" = "$WAN2_TABLE" ] || return 1
	[ "$(uci -q get network.lan_wan2_ipv4.priority)" = "11000" ] || return 1

	if [ "$WAN2_IPV6" = "1" ]; then
		if [ "$LAN4_UPLINK" = "wan2" ] && [ "$LUNA_IPV6_FIREWALL" = "1" ]; then
			[ "$(uci -q get network.lan_wan2_return_ipv6)" = "rule6" ] || return 1
			uci -q get network.lan_wan2_return_ipv6.disabled >/dev/null && return 1
			[ "$(uci -q get network.lan_wan2_return_ipv6.mark)" = "0x20000/0x20000" ] || return 1
			[ "$(uci -q get network.lan_wan2_return_ipv6.lookup)" = "$WAN2_TABLE" ] || return 1
			[ "$(uci -q get network.lan_wan2_return_ipv6.priority)" = "10400" ] || return 1
		else
			uci -q get network.lan_wan2_return_ipv6 >/dev/null && return 1
		fi
		if [ "$WAN2_PROTO" = "pppoe" ]; then
			[ "$(uci -q get network.wan2.ip6table)" = "$WAN2_TABLE" ] || return 1
		else
			[ "$(uci -q get network.wan2_6.ip6table)" = "$WAN2_TABLE" ] || return 1
		fi
		[ "$(uci -q get network.lan_wan2_internal_ipv6)" = "rule6" ] || return 1
		[ "$(uci -q get network.lan_wan2_internal_ipv6.in)" = "lan_wan2" ] || return 1
		[ "$(uci -q get network.lan_wan2_internal_ipv6.lookup)" = "main" ] || return 1
		[ "$(uci -q get network.lan_wan2_internal_ipv6.suppress_prefixlength)" = "0" ] || return 1
		[ "$(uci -q get network.lan_wan2_internal_ipv6.priority)" = "10500" ] || return 1
		[ "$(uci -q get network.lan_wan2_ipv6)" = "rule6" ] || return 1
		[ "$(uci -q get network.lan_wan2_ipv6.in)" = "lan_wan2" ] || return 1
		[ "$(uci -q get network.lan_wan2_ipv6.lookup)" = "$WAN2_TABLE" ] || return 1
		[ "$(uci -q get network.lan_wan2_ipv6.priority)" = "11000" ] || return 1
	else
		uci -q get network.lan_wan2_return_ipv6 >/dev/null && return 1
		uci -q get network.lan_wan2_internal_ipv6 >/dev/null && return 1
		uci -q get network.lan_wan2_ipv6 >/dev/null && return 1
	fi

	return 0
}

check_state() {
	local errors=0 br_lan br_wan2 br_wan2_ports ports wifi_network lan_target_forward wan_target_forward wan_target_block target_lan_forward target_wan_forward vpn_zone vpn1_block vpn1_forward vpn2_block vpn2_forward port option section
	echo "mwan-switch: 检查阶段 1/5：读取并验证设置"
	read_settings || return 1
	validate_settings || return 1

	echo "mwan-switch: 检查阶段 2/5：网络接口与物理端口"
	find_section_one network device name br-lan
	br_lan="$FOUND_SECTION"
	ports="$(uci -q get network.$br_lan.ports)"

	if [ "$MODE" = "dual" ]; then
		uci -q get network.wan2_probe >/dev/null && errors=$((errors + 1))
		[ "$(uci -q get network.wan2.device)" = "$WAN2_PORT" ] || errors=$((errors + 1))
		[ "$(uci -q get network.wan2.proto)" = "$WAN2_PROTO" ] || errors=$((errors + 1))
		if [ "$WAN2_PROTO" = "pppoe" ]; then
			[ "$(uci -q get network.wan2.username)" = "$WAN2_PPPOE_USERNAME" ] || errors=$((errors + 1))
			[ "$(uci -q get network.wan2.password)" = "$WAN2_PPPOE_PASSWORD" ] || errors=$((errors + 1))
			for option in mtu keepalive holdoff persist maxfail service ac reqprefix; do
				uci -q get "network.wan2.$option" >/dev/null && errors=$((errors + 1))
			done
			uci -q get network.wan2_6 >/dev/null && errors=$((errors + 1))
			if [ "$WAN2_IPV6" = "1" ]; then
				uci -q get network.wan2.ipv6 >/dev/null && errors=$((errors + 1))
				[ "$(uci -q get network.wan2.ip6table)" = "$WAN2_TABLE" ] || errors=$((errors + 1))
			else
				[ "$(uci -q get network.wan2.ipv6)" = "0" ] || errors=$((errors + 1))
				uci -q get network.wan2.ip6table >/dev/null && errors=$((errors + 1))
			fi
		else
			for option in username password mtu keepalive holdoff persist maxfail ipv6 service ac reqprefix ip6table; do
				uci -q get "network.wan2.$option" >/dev/null && errors=$((errors + 1))
			done
			if [ "$WAN2_IPV6" = "1" ]; then
				[ "$(uci -q get network.wan2_6.device)" = "@wan2" ] || errors=$((errors + 1))
				[ "$(uci -q get network.wan2_6.proto)" = "dhcpv6" ] || errors=$((errors + 1))
				[ "$(uci -q get network.wan2_6.reqprefix)" = "auto" ] || errors=$((errors + 1))
			else
				uci -q get network.wan2_6 >/dev/null && errors=$((errors + 1))
			fi
		fi
		if [ "$WAN2_DNS_MODE" = "custom" ]; then
			[ "$(uci -q get network.wan2.peerdns)" = "0" ] || errors=$((errors + 1))
		fi
		case " $ports " in *" $WAN2_PORT "*) errors=$((errors + 1));; esac
		find_section_one network device name br-lan-wan2
		br_wan2="$FOUND_SECTION"
		[ -n "$br_wan2" ] || errors=$((errors + 1))
		br_wan2_ports="$(uci -q get network.$br_wan2.ports)"
		case " $br_wan2_ports " in *" $WAN2_PORT "*) errors=$((errors + 1));; esac
		if [ "$LAN4_UPLINK" = "wan2" ]; then
			case " $br_wan2_ports " in *" $LAN4_PORT "*) ;; *) errors=$((errors + 1));; esac
			case " $ports " in *" $LAN4_PORT "*) errors=$((errors + 1));; esac
		else
			case " $ports " in *" $LAN4_PORT "*) ;; *) errors=$((errors + 1));; esac
			case " $br_wan2_ports " in *" $LAN4_PORT "*) errors=$((errors + 1));; esac
		fi
		for port in $DETECTED_LAN_PORTS; do
			[ "$port" = "$WAN2_PORT" ] && continue
			[ "$port" = "$LAN4_PORT" ] && continue
			case " $ports " in *" $port "*) ;; *) errors=$((errors + 1));; esac
			case " $br_wan2_ports " in *" $port "*) errors=$((errors + 1));; esac
		done
	else
		uci -q get network.wan2 >/dev/null && errors=$((errors + 1))
		if [ "$WAN2_FAILOVER_ACTIVE" = "1" ] && [ "$CONFIG_MODE" = "dual" ] && [ "$WAN2_LINK_MONITOR" = "1" ]; then
			case " $ports " in *" $WAN2_PORT "*) errors=$((errors + 1));; esac
			[ "$(uci -q get network.wan2_probe.device)" = "$WAN2_PORT" ] || errors=$((errors + 1))
			[ "$(uci -q get network.wan2_probe.proto)" = "none" ] || errors=$((errors + 1))
			[ "$(uci -q get network.wan2_probe.force_link)" = "1" ] || errors=$((errors + 1))
		else
			case " $ports " in *" $WAN2_PORT "*) ;; *) errors=$((errors + 1));; esac
			uci -q get network.wan2_probe >/dev/null && errors=$((errors + 1))
		fi
		case " $ports " in *" $LAN4_PORT "*) ;; *) errors=$((errors + 1));; esac
		for port in $DETECTED_LAN_PORTS; do
			if [ "$WAN2_FAILOVER_ACTIVE" = "1" ] && [ "$CONFIG_MODE" = "dual" ] && [ "$port" = "$WAN2_PORT" ]; then
				continue
			fi
			case " $ports " in *" $port "*) ;; *) errors=$((errors + 1));; esac
		done
	fi

	echo "mwan-switch: 检查阶段 3/5：策略路由与固定设备"
	check_lan_wan2_policy_state || errors=$((errors + 1))
	check_luna_ipv4_state || errors=$((errors + 1))
	check_luna_ipv6_firewall_state || errors=$((errors + 1))

	echo "mwan-switch: 检查阶段 4/5：无线出口"
	find_section_one wireless wifi-iface device "$WIFI24_RADIO"
	wifi_network="$(uci -q get wireless.$FOUND_SECTION.network)"
	if [ "$MODE" = "dual" ] && [ "$WIFI24_UPLINK" = "wan2" ]; then
		[ "$wifi_network" = "lan_wan2" ] || errors=$((errors + 1))
	else
		[ "$wifi_network" = "lan" ] || errors=$((errors + 1))
	fi

	find_section_one wireless wifi-iface device "$WIFI5_RADIO"
	if [ -n "$FOUND_SECTION" ]; then
		wifi_network="$(uci -q get wireless.$FOUND_SECTION.network)"
		if [ "$MODE" = "dual" ] && [ "$WIFI5_UPLINK" = "wan2" ]; then
			[ "$wifi_network" = "lan_wan2" ] || errors=$((errors + 1))
		else
			[ "$wifi_network" = "lan" ] || errors=$((errors + 1))
		fi
	fi

	echo "mwan-switch: 检查阶段 5/5：防火墙访问与 VPN 隔离"
	if ! check_return_path_state; then
		echo "mwan-switch: WAN2 IPv6 入站回程的 UCI 或运行时标记不一致" >&2
		errors=$((errors + 1))
	fi
	find_enabled_forwarding lan lan_wan2
	lan_target_forward="$FOUND_SECTION"
	find_enabled_forwarding wan lan_wan2
	wan_target_forward="$FOUND_SECTION"
	if [ "$(uci -q get firewall.mwan_block_wan_to_lan_wan2)" = "rule" ] && \
		[ "$(uci -q get firewall.mwan_block_wan_to_lan_wan2.name)" = "Block-WAN1-Upstream-to-LastLAN" ] && \
		[ "$(uci -q get firewall.mwan_block_wan_to_lan_wan2.src)" = "wan" ] && \
		[ "$(uci -q get firewall.mwan_block_wan_to_lan_wan2.dest)" = "lan_wan2" ] && \
		[ "$(uci -q get firewall.mwan_block_wan_to_lan_wan2.target)" = "REJECT" ] && \
		[ "$(uci -q get firewall.mwan_block_wan_to_lan_wan2.enabled)" != "0" ]; then
		wan_target_block=1
	else
		wan_target_block=0
	fi
	find_section_two firewall forwarding src lan_wan2 dest lan
	target_lan_forward="$FOUND_SECTION"
	find_section_two firewall forwarding src lan_wan2 dest wan
	target_wan_forward="$FOUND_SECTION"
	if [ "$MODE" = "dual" ] && [ "$LAN_ACCESS_TARGET" = "1" ]; then
		[ -n "$lan_target_forward" ] || errors=$((errors + 1))
		[ -n "$wan_target_forward" ] || errors=$((errors + 1))
		[ "$wan_target_block" = "0" ] || errors=$((errors + 1))
		uci -q get firewall.mwan_block_lan_to_lan_wan2 >/dev/null && errors=$((errors + 1))
		uci -q get firewall.mwan_block_wan_to_lan_wan2 >/dev/null && errors=$((errors + 1))
	elif [ "$MODE" = "dual" ]; then
		[ -n "$lan_target_forward" ] || errors=$((errors + 1))
		[ -z "$wan_target_forward" ] || errors=$((errors + 1))
		[ "$wan_target_block" = "1" ] || errors=$((errors + 1))
		uci -q get firewall.mwan_block_lan_to_lan_wan2 >/dev/null && errors=$((errors + 1))
		access_rules_are_first firewall || errors=$((errors + 1))
	else
		[ -z "$lan_target_forward" ] || errors=$((errors + 1))
		[ -z "$wan_target_forward" ] || errors=$((errors + 1))
		uci -q get firewall.mwan_block_lan_to_lan_wan2 >/dev/null && errors=$((errors + 1))
		uci -q get firewall.mwan_block_wan_to_lan_wan2 >/dev/null && errors=$((errors + 1))
	fi
	[ -z "$target_lan_forward" ] || errors=$((errors + 1))
	[ -z "$target_wan_forward" ] || errors=$((errors + 1))

	find_section_one firewall zone name vpn
	vpn_zone="$FOUND_SECTION"
	case " $(uci -q get firewall.$vpn_zone.device) " in *" tun+ "*) ;; *) errors=$((errors + 1));; esac

	find_section_one firewall rule name Block-OpenVPN-to-WAN1
	vpn1_block="$FOUND_SECTION"
	find_section_two firewall forwarding src vpn dest wan
	vpn1_forward="$FOUND_SECTION"
	if [ "$VPN_WAN1_ISOLATION" = "1" ]; then
		[ -n "$vpn1_block" ] && [ -z "$vpn1_forward" ] || errors=$((errors + 1))
	else
		[ -z "$vpn1_block" ] && [ -n "$vpn1_forward" ] || errors=$((errors + 1))
	fi

	find_section_one firewall rule name Block-OpenVPN-to-WAN2
	vpn2_block="$FOUND_SECTION"
	find_section_two firewall forwarding src vpn dest wan2
	vpn2_forward="$FOUND_SECTION"
	if [ "$MODE" = "dual" ]; then
		if [ "$VPN_WAN2_ISOLATION" = "1" ]; then
			[ -n "$vpn2_block" ] && [ -z "$vpn2_forward" ] || errors=$((errors + 1))
		else
			[ -z "$vpn2_block" ] && [ -n "$vpn2_forward" ] || errors=$((errors + 1))
		fi
	else
		[ -z "$vpn2_block" ] && [ -z "$vpn2_forward" ] || errors=$((errors + 1))
	fi

	if [ "$errors" -eq 0 ]; then
		echo "mwan-switch: 当前 UCI 状态与期望配置一致；检测到 $DETECTED_LAN_COUNT 个 LAN 网口，目标端口 $LAN4_PORT，WAN2 故障转移=$WAN2_FAILOVER_ACTIVE"
		return 0
	fi

	echo "mwan-switch: 检测到 $errors 项状态不一致"
	return 1
}

apply_config() {
	mkdir "$LOCK_DIR" 2>/dev/null || {
		log "已有应用任务正在运行"
		return 1
	}
	trap 'rmdir "$LOCK_DIR" 2>/dev/null' EXIT INT TERM

	NETWORK_CHANGED=0
	DHCP_CHANGED=0
	FIREWALL_CHANGED=0
	WIRELESS_CHANGED=0
	TARGET_PORT_MOVED=0
	WIFI24_MOVED=0
	WIFI5_MOVED=0

	read_settings || return 1
	normalize_failover_state || return 1
	validate_settings || return 1
	normalize_vpn_isolation_setting || return 1
	normalize_fixed_device_ipv4_settings || return 1
	find_wifi_sections || return 1
	adopt_managed_sections
	capture_target_port_network
	capture_wireless_networks
	apply_common_network
	apply_common_dhcp
	apply_common_firewall

	if [ "$MODE" = "dual" ]; then
		apply_dual_network
		apply_dual_dhcp
		apply_dual_firewall
	else
		apply_single_network
		apply_single_dhcp
		apply_single_firewall
	fi
	detect_target_port_move

	apply_wireless
	apply_luna_ipv4
	apply_luna_ipv6_firewall
	order_access_firewall_rules || return 1
	detect_wireless_moves
	commit_and_reload
	"$RETURN_PATH_HELPER" apply || {
		log "WAN2 IPv6 回程标记安装失败"
		return 1
	}
	reset_target_port_link || log "请检查 $LAN4_PORT 链路；自动重置未完成"
	reset_moved_wireless

	if check_state >/tmp/mwan-switch-check 2>&1; then
		log "应用完成，当前状态一致"
	else
		log "应用完成，但状态检查未通过：$(cat /tmp/mwan-switch-check)"
	fi
	rm -f /tmp/mwan-switch-check
	return 0
}

enable_monitor_service() {
	/etc/init.d/mwan-switch-monitor enable
	/etc/init.d/mwan-switch-monitor restart
}

disable_monitor_service() {
	/etc/init.d/mwan-switch-monitor stop 2>/dev/null
	/etc/init.d/mwan-switch-monitor disable
}

sync_monitor_service() {
	read_settings || return 1
	if [ "$CONFIG_MODE" = "dual" ] && [ "$WAN2_LINK_MONITOR" = "1" ]; then
		enable_monitor_service
		log "WAN2 持续检测服务已启用"
	else
		disable_monitor_service
		log "WAN2 持续检测服务已停止"
	fi
}

apply_monitor_state() {
	/usr/libexec/mwan-switch apply_state
}

set_failover_state() {
	local desired="$1" previous message
	previous="$(uci -q get mwan-switch.main.wan2_failover_active)"
	previous="${previous:-0}"
	[ "$previous" = "$desired" ] && return 0

	if [ "$desired" = "1" ]; then
		message="WAN2 链路断开，自动临时切换为仅 WAN1；原双 WAN 配置已保留"
	else
		message="WAN2 链路恢复，自动恢复此前的双 WAN 配置"
	fi

	uci set "mwan-switch.main.wan2_failover_active=$desired"
	uci commit mwan-switch
	log "$message"

	if apply_monitor_state >/tmp/mwan-switch-monitor-apply 2>&1; then
		rm -f /tmp/mwan-switch-monitor-apply
		return 0
	fi

	log "WAN2 自动切换应用失败：$(cat /tmp/mwan-switch-monitor-apply 2>/dev/null)"
	rm -f /tmp/mwan-switch-monitor-apply
	uci set "mwan-switch.main.wan2_failover_active=$previous"
	uci commit mwan-switch
	return 1
}

get_wan2_carrier() {
	local port="$1" carrier=0
	[ -r "/sys/class/net/$port/carrier" ] && carrier="$(cat "/sys/class/net/$port/carrier" 2>/dev/null)"
	printf '%s\n' "$carrier"
}

monitor() {
	local configured_mode enabled restore active port delay carrier down_for=0 up_for=0 interval=2
	log "WAN2 物理链路监控进程已启动"

	while true; do
		configured_mode="$(uci -q get mwan-switch.main.mode)"
		configured_mode="${configured_mode:-dual}"
		enabled="$(uci -q get mwan-switch.main.wan2_link_monitor)"
		enabled="${enabled:-0}"
		restore="$(uci -q get mwan-switch.main.wan2_link_restore)"
		restore="${restore:-1}"
		active="$(uci -q get mwan-switch.main.wan2_failover_active)"
		active="${active:-0}"
		port="$(uci -q get mwan-switch.main.wan2_port)"
		port="${port:-lan1}"
		delay="$(uci -q get mwan-switch.main.wan2_link_delay)"
		delay="${delay:-10}"
		case "$delay" in
			''|*[!0-9]*) delay=10 ;;
		esac

		if [ "$configured_mode" != "dual" ] || [ "$enabled" != "1" ]; then
			down_for=0
			up_for=0
			sleep 5
			continue
		fi

		carrier="$(get_wan2_carrier "$port")"

		if [ "$active" = "1" ]; then
			down_for=0
			if [ "$restore" = "1" ]; then
				if [ "$carrier" = "1" ]; then
					up_for=$((up_for + interval))
				else
					up_for=0
				fi
				if [ "$up_for" -ge "$delay" ]; then
					if set_failover_state 0; then
						up_for=0
						sleep "$delay"
					fi
				fi
			else
				up_for=0
			fi
		else
			up_for=0
			if [ "$carrier" = "1" ]; then
				down_for=0
			else
				down_for=$((down_for + interval))
			fi
			if [ "$down_for" -ge "$delay" ]; then
				if set_failover_state 1; then
					down_for=0
					sleep "$delay"
				fi
			fi
		fi

		sleep "$interval"
	done
}

apply() {
	apply_config || return 1
	sync_monitor_service
}

apply_state() {
	apply_config
}

check() {
	check_state
}

case "${1:-}" in
	apply)
		shift
		apply "$@"
		;;
	apply_state)
		shift
		apply_state "$@"
		;;
	check)
		shift
		check "$@"
		;;
	monitor)
		shift
		monitor "$@"
		;;
	*)
		echo "用法：$0 {apply|apply_state|check|monitor}" >&2
		exit 2
		;;
esac
