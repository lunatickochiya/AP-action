# ===== 基础参数 =====
CONFIG_BUILD_PATENTED=y
# ADD CCACHE
CONFIG_CCACHE=y
CONFIG_DEVEL=y

# ===== 基础/设备 =====
# autoset组件
CONFIG_PACKAGE_autoset=y
# CONFIG_PACKAGE_autoset_INCLUDE_temperature_script=y
CONFIG_PACKAGE_block-mount=y

# ===== 网络基础/防火墙 =====
CONFIG_PACKAGE_luci-app-upnp=m
CONFIG_PACKAGE_luci-app-netem=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-eqosplus=m
CONFIG_PACKAGE_luci-app-dawn=m
# CONFIG_PACKAGE_luci-app-easymesh=m
CONFIG_PACKAGE_luci-proto-openconnect=m
CONFIG_PACKAGE_luci-proto-sstp=m
# kmod network 组件
CONFIG_PACKAGE_kmod-iptunnel=m
CONFIG_PACKAGE_kmod-iptunnel6=m
CONFIG_PACKAGE_kmod-l2tp=y
CONFIG_PACKAGE_kmod-ppp=y
CONFIG_PACKAGE_kmod-mppe=y
CONFIG_PACKAGE_kmod-ppp-synctty=m
CONFIG_PACKAGE_kmod-pppoa=m
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_kmod-pppox=m
CONFIG_PACKAGE_kmod-pptp=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-udptunnel4=m
CONFIG_PACKAGE_kmod-udptunnel6=m
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-tcp-hybla=m
CONFIG_PACKAGE_kmod-tcp-scalable=m
#  network firewall 组件
CONFIG_PACKAGE_kmod-nf-ipt=y
CONFIG_PACKAGE_kmod-ipt-tproxy=y
CONFIG_PACKAGE_kmod-ipt-fullconenat=y
CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_miniupnpd-iptables=m
CONFIG_MINIUPNPD_IGDv2=y
# CONFIG_PACKAGE_miniupnpd-nftables is not set
# CONFIG_PACKAGE_xtables-legacy=y
# CONFIG_PACKAGE_ebtables-legacy=y
# CONFIG_PACKAGE_ebtables-legacy-utils=y
CONFIG_PACKAGE_iptables-mod-fullconenat=y
CONFIG_PACKAGE_ip6tables-mod-fullconenat=y
CONFIG_PACKAGE_ip6tables-mod-nat=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_iptables-mod-socket=y
CONFIG_PACKAGE_iptables-mod-iprange=y
# CONFIG_PACKAGE_nftables-json is not set
# CONFIG_PACKAGE_nftables-nojson is not set

# ===== VPN/隧道 =====
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-app-libreswan=m
CONFIG_PACKAGE_luci-app-wireguard=m
CONFIG_PACKAGE_ppp-mod-pppol2tp=m
CONFIG_PACKAGE_luci-proto-vxlan=m
# CONFIG_PACKAGE_luci-proto-openfortivpn=y
CONFIG_PACKAGE_kmod-pppol2tp=y
CONFIG_PACKAGE_kmod-wireguard=y
# openvpn 组件
CONFIG_PACKAGE_luci-app-openvpn-server-client=m
CONFIG_PACKAGE_openvpn-easy-rsa=m
CONFIG_PACKAGE_openvpn-openssl=m
CONFIG_PACKAGE_wireguard-tools=m
CONFIG_PACKAGE_tailscale=m

# ===== 下载/网盘/媒体 =====
# CONFIG_PACKAGE_luci-app-aria2=y
CONFIG_PACKAGE_luci-app-msd_lite=m
CONFIG_PACKAGE_luci-app-udpxy=m
# CONFIG_PACKAGE_aria2=y
# CONFIG_PACKAGE_ariang=y
# Aria2 组件
CONFIG_ARIA2_OPENSSL=y
CONFIG_ARIA2_LIBXML2=y
CONFIG_ARIA2_BITTORRENT=y
CONFIG_ARIA2_METALINK=y
CONFIG_ARIA2_SFTP=y
CONFIG_ARIA2_ASYNC_DNS=y
CONFIG_ARIA2_COOKIE=y
CONFIG_ARIA2_WEBSOCKET=y
CONFIG_PACKAGE_luci-app-nvr=m

# ===== 存储/文件共享 =====
CONFIG_PACKAGE_luci-app-filetransfer=y
CONFIG_PACKAGE_luci-app-fileassistant=y
CONFIG_PACKAGE_luci-app-vsftpd=y
CONFIG_PACKAGE_luci-app-ksmbd=m
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_luci-app-filebrowser=m
CONFIG_PACKAGE_filebrowser=m
# ADD harbor
CONFIG_PACKAGE_luci-app-harbor-file=y

# ===== 打印/外设 =====
CONFIG_PACKAGE_luci-app-usb-printer=y
CONFIG_PACKAGE_luci-app-cupsd=y
CONFIG_PACKAGE_libcupsimage=y
CONFIG_PACKAGE_cups-bsd=m
CONFIG_PACKAGE_cups-client=m
CONFIG_PACKAGE_cups-filters=m
CONFIG_PACKAGE_cups-ppdc=m
CONFIG_PACKAGE_brlaser=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=m

# ===== 主题/界面 =====
# Luci-app组件
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-theme-argon=y

# ===== 监控/系统 =====
CONFIG_PACKAGE_luci-app-ramfree=y
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_luci-app-parentcontrol=m
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y

# ===== 网络服务 =====
CONFIG_PACKAGE_luci-app-smartdns=m
CONFIG_PACKAGE_luci-app-dnsfilter=m
CONFIG_PACKAGE_luci-app-omcproxy=m
CONFIG_PACKAGE_luci-app-natmap=m

# ===== 工具 =====
CONFIG_PACKAGE_luci-app-ttyd=m
CONFIG_PACKAGE_wget-ssl=m
CONFIG_PACKAGE_luci-app-tcpdump=m

# ===== 其他 =====
CONFIG_PACKAGE_luci-app-banmac=y
CONFIG_PACKAGE_luci-app-iptvhelper=m
# CONFIG_PACKAGE_libustream-mbedtls is not set
CONFIG_PACKAGE_libustream-openssl=y
# CONFIG_PACKAGE_libmbedtls is not set
CONFIG_PACKAGE_libopenssl-conf=y
# Remove feed
CONFIG_FEED_lunatic7=n

# ===== 构建选项 =====
# Curl 组件
# CONFIG_LIBCURL_MBEDTLS is not set
CONFIG_LIBCURL_OPENSSL=y
# Openssl Engine/Hardware Support
CONFIG_OPENSSL_ENGINE=y
